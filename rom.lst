01:0000195C 61000212        	  1098: 	BSR.W	PRTLN		display the line in error up to the 0
01:00001960 109F            	  1099: 	MOVE.B	(SP)+,(A0)	restore the character
01:00001962 103C003F        	  1100: 	MOVE.B	#'?',D0         display a "?"
01:00001966 6100F704        	  1101: 	BSR	OUTCH
01:0000196A 4240            	  1102: 	CLR	D0
