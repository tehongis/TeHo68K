01:00001A36 650C            	  1194: 	BCS	FNDRET		if so, return with Z=0 & C=1
01:00001A38 1419            	  1195: 	MOVE.B	(A1)+,D2	if not, get a line no.
01:00001A3A E14A            	  1196: 	LSL	#8,D2
01:00001A3C 1411            	  1197: 	MOVE.B	(A1),D2
01:00001A3E 5389            	  1198: 	SUBQ.L	#1,A1
01:00001A40 B441            	  1199: 	CMP	D1,D2		is this the line we want?
01:00001A42 6502            	  1200: 	BCS	FNDNXT		no, not there yet
01:00001A44 4E75            	  1201: FNDRET	RTS			return the cond. codes
                            	  1202: 
01:00001A46 5489            	  1203: FNDNXT	ADDQ.L	#2,A1		find the next line
                            	  1204: 
01:00001A48 0C19000D        	  1205: FNDSKP	CMP.B	#CR,(A1)+	try to find a CR
01:00001A4C 66FA            	  1206: 	BNE	FNDSKP		keep looking
01:00001A4E 60DE            	  1207: 	BRA	FNDLNP		check if end of text
