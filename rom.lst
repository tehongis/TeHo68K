                            	   256: *
                            	   257: *******************************************************************
                            	   258: *
                            	   259: * What follows is the code to execute direct and statement
                            	   260: * commands. Control is transferred to these points via the command
                            	   261: * table lookup code of 'DIRECT' and 'EXEC' in the last section.
                            	   262: * After the command is executed, control is transferred to other
                            	   263: * sections as follows:
                            	   264: *
                            	   265: * For 'LIST', 'NEW', and 'STOP': go back to the warm start point.
                            	   266: * For 'RUN': go execute the first stored line if any; else go
                            	   267: * back to the warm start point.
                            	   268: * For 'GOTO' and 'GOSUB': go execute the target line.
                            	   269: * For 'RETURN' and 'NEXT'; go back to saved return line.
                            	   270: * For all others: if 'CURRNT' is 0, go to warm start; else go
                            	   271: * execute next command. (This is done in 'FINISH'.)
                            	   272: *
                            	   273: *******************************************************************
                            	   274: *
                            	   275: * *** NEW *** STOP *** RUN (& friends) *** GOTO ***
                            	   276: *
                            	   277: * 'NEW<CR>' sets TXTUNF to point to TXTBGN
                            	   278: *
                            	   279: * 'STOP<CR>' goes back to WSTART
                            	   280: *
                            	   281: * 'RUN<CR>' finds the first stored line, stores its address
                            	   282: * in CURRNT, and starts executing it. Note that only those
                            	   283: * commands in TAB2 are legal for a stored program.
                            	   284: *
                            	   285: * There are 3 more entries in 'RUN':
                            	   286: * 'RUNNXL' finds next line, stores it's address and executes it.
                            	   287: * 'RUNTSL' stores the address of this line and executes it.
                            	   288: * 'RUNSML' continues the execution on same line.
                            	   289: *
                            	   290: * 'GOTO expr<CR>' evaluates the expression, finds the target
                            	   291: * line, and jumps to 'RUNTSL' to do it.
                            	   292: *
01:0000134A 610005DE        	   293: NEW	BSR.W	ENDCHK
01:0000134E 21F811781CC0    	   294: 	MOVE.L	TXTBGN,TXTUNF	set the end pointer
                            	   295: 
01:00001354 610005D4        	   296: LSTOP	BSR.W	ENDCHK
01:00001358 6000FE50        	   297: 	BRA	WSTART
                            	   298: 
01:0000135C 610005CC        	   299: RUN	BSR.W	ENDCHK
01:00001360 20781178        	   300: 	MOVE.L	TXTBGN,A0	set pointer to beginning
01:00001364 21C81CA0        	   301: 	MOVE.L	A0,CURRNT
                            	   302: 
01:00001368 4AB81CA0        	   303: RUNNXL	TST.L	CURRNT		executing a program?
01:0000136C 6700FE3C        	   304: 	BEQ.W	WSTART		if not, we've finished a direct stat.
01:00001370 7200            	   305: 	CLR.L	D1		else find the next line number
01:00001372 2248            	   306: 	MOVE.L	A0,A1
01:00001374 610006B8        	   307: 	BSR.W	FNDLNP
01:00001378 6500FE30        	   308: 	BCS	WSTART		if we've fallen off the end, stop
                            	   309: 
01:0000137C 21C91CA0        	   310: RUNTSL	MOVE.L	A1,CURRNT	set CURRNT to point to the line no.
01:00001380 2049            	   311: 	MOVE.L	A1,A0		set the text pointer to
01:00001382 5488            	   312: 	ADDQ.L	#2,A0		the start of the line text
                            	   313: 
01:00001384 610008A8        	   314: RUNSML	BSR.W	CHKIO		see if a control-C was pressed
01:00001388 43F8125A        	   315: 	LEA	TAB2,A1 	find command in TAB2
01:0000138C 45F812BE        	   316: 	LEA	TAB2.1,A2
01:00001390 6000FF72        	   317: 	BRA	EXEC		and execute it
                            	   318: 
01:00001394 61000354        	   319: GOTO	BSR.W	EXPR		evaluate the following expression
01:00001398 61000590        	   320: 	BSR.W	ENDCHK		must find end of line
01:0000139C 2200            	   321: 	MOVE.L	D0,D1
01:0000139E 61000680        	   322: 	BSR.W	FNDLN		find the target line
01:000013A2 660005DA        	   323: 	BNE.W	QHOW		no such line no.
01:000013A6 60D4            	   324: 	BRA	RUNTSL		go do it
