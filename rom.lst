                            	   632: *
                            	   633: *******************************************************************
                            	   634: *
                            	   635: * *** LOAD *** & SAVE ***
                            	   636: *
                            	   637: * These two commands transfer a program to/from an auxiliary
                            	   638: * device such as a cassette, another computer, etc.  The program
                            	   639: * is converted to an easily-stored format: each line starts with
                            	   640: * a colon, the line no. as 4 hex digits, and the rest of the line.
                            	   641: * At the end, a line starting with an '@' sign is sent.  This
                            	   642: * format can be read back with a minimum of processing time by
                            	   643: * the 68000.
                            	   644: *
01:000015E2 20781178        	   645: LLOAD	MOVE.L	TXTBGN,A0	set pointer to start of prog. area
01:000015E6 103C000D        	   646: 	MOVE.B	#CR,D0		For a CP/M host, tell it we're ready...
01:000015EA 6100FB80        	   647: 	BSR	GOAUXO		by sending a CR to finish PIP command.
01:000015EE 6100FB80        	   648: LOD1	BSR	GOAUXI		look for start of line
01:000015F2 67FA            	   649: 	BEQ	LOD1
01:000015F4 B03C0040        	   650: 	CMP.B	#'@',D0         end of program?
01:000015F8 671E            	   651: 	BEQ	LODEND
01:000015FA B03C003A        	   652: 	CMP.B	#':',D0         if not, is it start of line?
01:000015FE 66EE            	   653: 	BNE	LOD1		if not, wait for it
01:00001600 611E            	   654: 	BSR	GBYTE		get first byte of line no.
01:00001602 10C1            	   655: 	MOVE.B	D1,(A0)+	store it
01:00001604 611A            	   656: 	BSR	GBYTE		get 2nd bye of line no.
01:00001606 10C1            	   657: 	MOVE.B	D1,(A0)+	store that, too
01:00001608 6100FB66        	   658: LOD2	BSR	GOAUXI		get another text char.
01:0000160C 67FA            	   659: 	BEQ	LOD2
01:0000160E 10C0            	   660: 	MOVE.B	D0,(A0)+	store it
01:00001610 B03C000D        	   661: 	CMP.B	#CR,D0		is it the end of the line?
01:00001614 66F2            	   662: 	BNE	LOD2		if not, go back for more
01:00001616 60D6            	   663: 	BRA	LOD1		if so, start a new line
01:00001618 21C81CC0        	   664: LODEND	MOVE.L	A0,TXTUNF	set end-of program pointer
01:0000161C 6000FB8C        	   665: 	BRA	WSTART		back to direct mode
                            	   666: 
01:00001620 7401            	   667: GBYTE	MOVEQ	#1,D2		get two hex characters from auxiliary
01:00001622 4241            	   668: 	CLR	D1		and store them as a byte in D1
01:00001624 6100FB4A        	   669: GBYTE1	BSR	GOAUXI		get a char.
01:00001628 67FA            	   670: 	BEQ	GBYTE1
01:0000162A B03C0041        	   671: 	CMP.B	#'A',D0
01:0000162E 6502            	   672: 	BCS	GBYTE2
01:00001630 5F00            	   673: 	SUBQ.B	#7,D0		if greater than 9, adjust
01:00001632 C03C000F        	   674: GBYTE2	AND.B	#$F,D0		strip ASCII
01:00001636 E909            	   675: 	LSL.B	#4,D1		put nybble into the result
01:00001638 8200            	   676: 	OR.B	D0,D1
01:0000163A 51CAFFE8        	   677: 	DBRA	D2,GBYTE1	get another char.
01:0000163E 4E75            	   678: 	RTS
                            	   679: 
01:00001640 20781178        	   680: SAVE	MOVE.L	TXTBGN,A0	set pointer to start of prog. area
01:00001644 22781CC0        	   681: 	MOVE.L	TXTUNF,A1	set pointer to end of prog. area
01:00001648 103C000D        	   682: SAVE1	MOVE.B	#CR,D0		send out a CR & LF (CP/M likes this)
01:0000164C 6100FB1E        	   683: 	BSR	GOAUXO
01:00001650 103C000A        	   684: 	MOVE.B	#LF,D0
01:00001654 6100FB16        	   685: 	BSR	GOAUXO
01:00001658 B3C8            	   686: 	CMP.L	A0,A1		are we finished?
01:0000165A 631E            	   687: 	BLS	SAVEND
01:0000165C 103C003A        	   688: 	MOVE.B	#':',D0         if not, start a line
01:00001660 6100FB0A        	   689: 	BSR	GOAUXO
01:00001664 1218            	   690: 	MOVE.B	(A0)+,D1	send first half of line no.
01:00001666 6136            	   691: 	BSR	PBYTE
01:00001668 1218            	   692: 	MOVE.B	(A0)+,D1	and send 2nd half
01:0000166A 6132            	   693: 	BSR	PBYTE
01:0000166C 1018            	   694: SAVE2	MOVE.B	(A0)+,D0	get a text char.
01:0000166E B03C000D        	   695: 	CMP.B	#CR,D0		is it the end of the line?
01:00001672 67D4            	   696: 	BEQ	SAVE1		if so, send CR & LF and start new line
01:00001674 6100FAF6        	   697: 	BSR	GOAUXO		send it out
01:00001678 60F2            	   698: 	BRA	SAVE2		go back for more text
01:0000167A 103C0040        	   699: SAVEND	MOVE.B	#'@',D0         send end-of-program indicator
01:0000167E 6100FAEC        	   700: 	BSR	GOAUXO
01:00001682 103C000D        	   701: 	MOVE.B	#CR,D0		followed by a CR & LF
01:00001686 6100FAE4        	   702: 	BSR	GOAUXO
01:0000168A 103C000A        	   703: 	MOVE.B	#LF,D0
01:0000168E 6100FADC        	   704: 	BSR	GOAUXO
01:00001692 103C001A        	   705: 	MOVE.B	#$1A,D0 	and a control-Z to end the CP/M file
01:00001696 6100FAD4        	   706: 	BSR	GOAUXO
01:0000169A 6000FB0E        	   707: 	BRA	WSTART		then go do a warm start
                            	   708: 
01:0000169E 7401            	   709: PBYTE	MOVEQ	#1,D2		send two hex characters from D1's low byte
01:000016A0 E919            	   710: PBYTE1	ROL.B	#4,D1		get the next nybble
01:000016A2 1001            	   711: 	MOVE.B	D1,D0
01:000016A4 C03C000F        	   712: 	AND.B	#$F,D0		strip off garbage
01:000016A8 D03C0030        	   713: 	ADD.B	#'0',D0         make it into ASCII
01:000016AC B03C0039        	   714: 	CMP.B	#'9',D0
01:000016B0 6302            	   715: 	BLS	PBYTE2
01:000016B2 5E00            	   716: 	ADDQ.B	#7,D0		adjust if greater than 9
01:000016B4 6100FAB6        	   717: PBYTE2	BSR	GOAUXO		send it out
01:000016B8 51CAFFE6        	   718: 	DBRA	D2,PBYTE1	then send the next nybble
01:000016BC 4E75            	   719: 	RTS
