                            	     5:     include "HAL.i"

Source: "HAL.i"
                            	     1: ; =============================================================================
                            	     2: ; MINITIETOKONEEN HAL (HARDWARE ABSTRACTION LAYER) MÄÄRITTELYT
                            	     3: ; Kääntäjäyhteensopivuus: vasm68k_mot (Motorola Syntax)
                            	     4: ; Syntaksisäännöt: LABELIT ISROLLA, käskyt ja rekisterit pienellä.
                            	     5: ; =============================================================================
                            	     6: 
                            	     7: SYSTEM_MEM_SIZE equ $100000
                            	     8: 
                            	     9: VRAM_START    equ   $00080000
                            	    10: VRAM_SIZE     equ   (800*600)
                            	    11: PALETTE_START equ   $00088000
                            	    12: PALETTE_SIZE  equ   (256*4)
                            	    13: FONT_ROM      EQU   $0008c000
                            	    14: 
                            	    15: ; Virtuaalisen UART:n rekisterit
                            	    16: UART_IN_ADDR  equ   $0008F000
                            	    17: UART_OUT_ADDR equ   $0008F004
                            	    18: 

Source: "asm/rom_monitor.asm"
                            	     6: 
                            	     7: * =================================================================
                            	     8: * VEKTORITAULUKKO (Alkaa osoitteesta $00000000)
                            	     9: * =================================================================
                            	    10:     ORG     $00000000
00:00000000 00080000        	    11:     DC.L    $00080000           * Alustus: Pinon huippu (Stack Pointer)
00:00000004 00001000        	    12:     DC.L    Main                * Alustus: Ohjelman aloitusosoite (PC)
                            	    13: 
                            	    14:     ORG     $00000064           * IRQ 1 Autovector (Näppäimistö sisään)
01:00000064 00001086        	    15:     DC.L    Keyboard_ISR
                            	    16: 
                            	    17:     ORG     $00000068           * IRQ 2 Autovector (Tulostus ulos)
02:00000068 0000105E        	    18:     DC.L    Output_ISR
                            	    19: 
                            	    20: * =================================================================
                            	    21: * PÄÄOHJELMA
                            	    22: * =================================================================
                            	    23:               ORG   $00001000   * Ohjelmakoodin paikka RAM-muistissa
                            	    24: Main:
                            	    25: 
                            	    26: ; --- Init_Palette
03:00001000 41F8118E        	    27:     LEA     VGA_Palette_Data,A0  * Osoitin tämän taulukon alkuun
03:00001004 43F900088000    	    28:     LEA     PALETTE_START,A1           * Osoitin emuloituun palettimuistiin
03:0000100A 303C0100        	    29:     MOVE.W  #256,D0              * Looppi pyörii 256 kertaa (kaikki värit)
                            	    30: .paletteLoop
03:0000100E 22D8            	    31:     MOVE.L  (A0)+,(A1)+          * Kopioidaan väri ($00RRGGBB) palettiin
03:00001010 5340            	    32:     SUBQ.W  #1,D0
03:00001012 66FA            	    33:     BNE     .paletteLoop
                            	    34: 
                            	    35:     * 1. Alustetaan muuttujat nollaksi
03:00001014 42B81158        	    36:     CLR.L   StringPtr
                            	    37: 
                            	    38:     * 3. KUTSUTAAN TULOSTUSRUTIINIA: Tulostetaan haluttu viesti
03:00001018 41F81164        	    39:     LEA     MyMessage,A0        * Ladataan viestin osoite A0-rekisteriin
03:0000101C 6126            	    40:     BSR     PrintString         * Kutsutaan tulostuksen käynnistystä
                            	    41: 
                            	    42:     * 2. Sallitaan keskeytykset tasoilla 1 ja 2 (SR interrupt mask = 0)
03:0000101E 027CF8FF        	    43:     ANDI.W  #$F8FF,SR
                            	    44: 
                            	    45:     * 3. KUTSUTAAN TULOSTUSRUTIINIA: Tulostetaan haluttu viesti
03:00001022 42B81158        	    46:     CLR.L   StringPtr
03:00001026 41F81164        	    47:     LEA     MyMessage,A0        * Ladataan viestin osoite A0-rekisteriin
03:0000102A 7602            	    48:     move.l  #$2,d3
03:0000102C 6100009A        	    49:     BSR     PrintStringFB         * Kutsutaan tulostuksen käynnistystä
                            	    50: 
                            	    51: ; ---- debug writing to screen.
03:00001030 303C0000        	    52:     move.w #$0,d0
03:00001034 41F900090000    	    53:     LEA     VRAM_START+65536,A0
                            	    54: Loop:
03:0000103A 52300000        	    55:     add.B   #$01,(A0,d0.w)
03:0000103E 5240            	    56:     addq.w  #1,d0
                            	    57: 
03:00001040 4EF8103A        	    58:     JMP     Loop
                            	    59: 
                            	    60: 
                            	    61: * =================================================================
                            	    62: * PALETIN LATAUSRUTIINI
                            	    63: * =================================================================
                            	    64: 
                            	    65: * =================================================================
                            	    66: * ALIOHJELMA: PrintString (Käynnistää tulostusketjun)
                            	    67: * Sisääntulo: A0 = Tulostettavan merkkijonon osoite
                            	    68: * =================================================================
                            	    69: PrintString:
03:00001044 48E78080        	    70:     MOVEM.L D0/A0,-(SP)         * Tallenna käytettävät rekisterit
                            	    71: 
                            	    72:     * Tarkistetaan heti, onko jono tyhjä (ensimmäinen merkki nolla)
03:00001048 1010            	    73:     MOVE.B  (A0),D0
03:0000104A 670C            	    74:     BEQ     Print_Done          * Jos on nolla, älä tee mitään
                            	    75: 
                            	    76:     * Asetetaan osoitin valmiiksi seuraavaa merkkiä varten (A0 + 1)
03:0000104C 5288            	    77:     ADDQ.L  #1,A0
03:0000104E 21C81158        	    78:     MOVE.L  A0,StringPtr
                            	    79: 
                            	    80:     * Kirjoitetaan ensimmäinen merkki suoraan UART:iin.
                            	    81:     * Tämä saa C-koodin tulostamaan sen ja herättämään ensimmäisen IRQ 2:n.
03:00001052 13C00008F004    	    82:     MOVE.B  D0,UART_OUT_ADDR
                            	    83: 
                            	    84: Print_Done:
03:00001058 4CDF0101        	    85:     MOVEM.L (SP)+,D0/A0         * Palauta rekisterit
03:0000105C 4E75            	    86:     RTS
                            	    87: 
                            	    88: * =================================================================
                            	    89: * IRQ 2: TULOSTUKSEN KESKEYTYSRUTIINI (MC68000-YHTEENSOPIVA)
                            	    90: * =================================================================
                            	    91: Output_ISR:
03:0000105E 48E78080        	    92:     MOVEM.L D0/A0,-(SP)         * Tallenna rekisterit suojaukseen
                            	    93: 
03:00001062 20781158        	    94:     MOVE.L  StringPtr,A0        * Ladataan nykyinen teksti-osoitin
                            	    95:     
                            	    96:     * KORJAUS: Alkuperäinen 68000 ei tue TST.L A0 -käskyä.
                            	    97:     * Verrataan osoiterekisteriä arvoon 0 CMPA-käskyllä (asettaa Z-lipun, jos NULL).
03:00001066 B0FC0000        	    98:     CMPA.W  #0,A0               
03:0000106A 6714            	    99:     BEQ     ISR_Done            * Jos on nolla, ei aktiivista viestiä -> poistu
                            	   100: 
03:0000106C 1018            	   101:     MOVE.B  (A0)+,D0            * Luetaan merkki ja siirretään osoitinta eteenpäin
03:0000106E 670C            	   102:     BEQ     Message_Finished    * Jos merkki on $00, viesti loppui
                            	   103: 
                            	   104:     * Päivitetään uusi osoitin muistiin seuraavaa keskeytystä varten
03:00001070 21C81158        	   105:     MOVE.L  A0,StringPtr        
                            	   106:     
                            	   107:     * Lähetetään merkki laitteelle (C-puoli tulostace ja nostaa uuden IRQ 2:n)
03:00001074 13C00008F004    	   108:     MOVE.B  D0,UART_OUT_ADDR
03:0000107A 6004            	   109:     BRA     ISR_Done
                            	   110: 
                            	   111: Message_Finished:
03:0000107C 42B81158        	   112:     CLR.L   StringPtr           * Nollataan osoitin merkiksi siitä, että viesti päättyi
                            	   113: 
                            	   114: ISR_Done:
03:00001080 4CDF0101        	   115:     MOVEM.L (SP)+,D0/A0         * Palauta rekisterit
03:00001084 4E73            	   116:     RTE                         * Paluu keskeytyksestä
                            	   117: 
                            	   118: * =================================================================
                            	   119: * IRQ 1: NÄPPÄIMISTÖN KESKEYTYSRUTIINI (MUOKATTU HEKSATULOSTUKSELLE)
                            	   120: * =================================================================
                            	   121: Keyboard_ISR:
03:00001086 48E7E080        	   122:     MOVEM.L D0-D2/A0,-(SP)      * Tallenna kaikki käytettävät rekisterit
                            	   123: 
03:0000108A 10390008F000    	   124:     MOVE.B  (UART_IN_ADDR),D0        * 1. Luetaan saapunut näppäinkoodi D0-rekisteriin
03:00001090 41F8115C        	   125:     LEA     HexBuffer,A0        * 2. Otetaan puskurin osoite A0-rekisteriin
                            	   126: 
                            	   127:     * --- YLEMPI HEX-MERKKI (Ylemmät 4 bittiä) ---
03:00001094 1200            	   128:     MOVE.B  D0,D1               * Otetaan kopio koodista D1-rekisteriin
03:00001096 E809            	   129:     LSR.B   #4,D1               * Siirretään yläbitit alabiteiksi (esim. $41 -> $04)
03:00001098 6120            	   130:     BSR     ConvertNibble       * Muutetaan numeroksi/kirjaimeksi ASCII-muotoon
03:0000109A 10C1            	   131:     MOVE.B  D1,(A0)+            * Tallennetaan puskurin ensimmäiseksi merkiksi
                            	   132: 
                            	   133:     * --- ALEMPI HEX-MERKKI (Alemmat 4 bittiä) ---
03:0000109C 1200            	   134:     MOVE.B  D0,D1               * Otetaan uusi kopio koodista D1-rekisteriin
03:0000109E 0201000F        	   135:     ANDI.B  #$0F,D1             * Maskataan yläbitit pois (esim. $41 -> $01)
03:000010A2 6116            	   136:     BSR     ConvertNibble       * Muutetaan ASCII-muotoon
03:000010A4 10C1            	   137:     MOVE.B  D1,(A0)+            * Tallennetaan puskurin toiseksi merkiksi
                            	   138: 
                            	   139:     * --- LOPPUMERKIT ---
03:000010A6 10FC0020        	   140:     MOVE.B  #32,(A0)+           * Lisätään välilyönti (ASCII 32) heksalukujen väliin
03:000010AA 10BC0000        	   141:     MOVE.B  #0,(A0)             * Lisätään nollaterminaattori merkkijonon loppuun ($00)
                            	   142: 
                            	   143:     * --- TULOSTUS ---
03:000010AE 41F8115C        	   144:     LEA     HexBuffer,A0        * Ladataan puskurin alkuosoite takaisin A0:aan
03:000010B2 6190            	   145:     BSR     PrintString         * Kutsutaan valmista tulostusrutiinia!
                            	   146: 
03:000010B4 4CDF0107        	   147:     MOVEM.L (SP)+,D0-D2/A0      * Palautetaan rekisterit
03:000010B8 4E73            	   148:     RTE                         * Paluu keskeytyksestä
                            	   149: 
                            	   150: * =================================================================
                            	   151: * APURUTIINI: ConvertNibble (Muuntaa 4 bittiä ASCII-heksamerkiksi)
                            	   152: * Sisääntulo: D1 = Alimmat 4 bittiä sisältävät muunnettavan arvon (0-15)
                            	   153: * Ulostulo:   D1 = Valmis ASCII-merkki ('0'-'9' tai 'A'-'F')
                            	   154: * =================================================================
                            	   155: ConvertNibble:
03:000010BA 0C01000A        	   156:     CMPI.B  #10,D1              * Onko arvo alle 10 (0-9)?
03:000010BE 6D02            	   157:     BLT     IsDigit             * Jos on, hypätään suoraan numeron käsittelyyn
                            	   158:     
                            	   159:     * Jos arvo on 10-15 (A-F):
03:000010C0 5E01            	   160:     ADDQ.B  #7,D1               * Lisätään erotus numeroiden ja kirjainten välillä ASCII-taulukossa
                            	   161: IsDigit:
03:000010C2 06010030        	   162:     ADDI.B  #$30,D1             * Lisätään '0'-merkin ASCII-arvo ($30)
03:000010C6 4E75            	   163:     RTS
                            	   164: 
                            	   165: ; --------- Framebuffer printString
                            	   166: * =================================================================
                            	   167: * ALIOHJELMA: PrintStringFB (Framebuffer/VRAM-versio)
                            	   168: * Sisääntulo: A0 = Null-terminoidun merkkijonon osoite
                            	   169: *             D3.B = Tekstin väri (VGA-paletin indeksi)
                            	   170: * =================================================================
                            	   171: PrintStringFB:
03:000010C8 48E7E080        	   172:     MOVEM.L D0-D2/A0,-(SP)      * Tallenna käytettävät rekisterit
                            	   173: 
                            	   174: Print_Char_Loop:
03:000010CC 1018            	   175:     MOVE.B  (A0)+,D0            * Lue merkki ja siirrä osoitinta eteenpäin
03:000010CE 6736            	   176:     BEQ     Print_DoneFB         * Jos merkki on 0 (loppumerkki), lopeta
                            	   177: 
                            	   178:     * TARKISTETAAN RIVINVAIHTO (ASCII 10 / Newline)
03:000010D0 0C00000A        	   179:     CMPI.B  #10,D0
03:000010D4 6720            	   180:     BEQ     Handle_Newline
                            	   181: 
                            	   182:     * TAVALLISEN MERKIN TULOSTUS
                            	   183:     * Ladataan kursorin nykyiset koordinaatit DrawChar-aliohjelmalle
03:000010D6 32381160        	   184:     MOVE.W  (CursorX),D1
03:000010DA 34381162        	   185:     MOVE.W  (CursorY),D2
                            	   186:     
03:000010DE 612C            	   187:     BSR     DrawChar            * Piirretään merkki ruudulle!
                            	   188: 
                            	   189:     * Siirretään kursorikohdistinta 8 pikseliä oikealle seuraavaa merkkiä varten
03:000010E0 5041            	   190:     ADDQ.W  #8,D1
03:000010E2 0C410320        	   191:     CMPI.W  #800,D1             * Saavutettiinko ruudun oikea reuna?
03:000010E6 6D04            	   192:     BLT     Save_Cursor_X
                            	   193:     
                            	   194:     * Jos reuna saavutettiin, tehdään automaattinen rivinvaihto
03:000010E8 4241            	   195:     CLR.W  D1                  * X = 0
03:000010EA 5042            	   196:     ADDQ.W  #8,D2               * Y = Y + 8
                            	   197: 
                            	   198: Save_Cursor_X:
03:000010EC 31C11160        	   199:     MOVE.W  D1,(CursorX)
03:000010F0 31C21162        	   200:     MOVE.W  D2,(CursorY)
03:000010F4 60D6            	   201:     BRA     Print_Char_Loop     * Siirrytään seuraavaan merkkiin
                            	   202: 
                            	   203: Handle_Newline:
                            	   204:     * Siirretään kursori seuraavan rivin alkuun (X=0, Y=Y+8)
03:000010F6 42781160        	   205:     CLR.W   (CursorX)
03:000010FA 34381162        	   206:     MOVE.W  (CursorY),D2
03:000010FE 5042            	   207:     ADDQ.W  #8,D2
                            	   208:     
                            	   209:     * Valinnainen: Tähän voi lisätä tarkistuksen jos Y > 592 (ruudun rullaus/scroll),
                            	   210:     * mutta pidetään se aluksi yksinkertaisena.
03:00001100 31C21162        	   211:     MOVE.W  D2,(CursorY)
03:00001104 60C6            	   212:     BRA     Print_Char_Loop     * Jatgetaan merkkijonon läpikäyntiä
                            	   213: 
                            	   214: Print_DoneFB:
03:00001106 4CDF0107        	   215:     MOVEM.L (SP)+,D0-D2/A0      * Palauta rekisterit
03:0000110A 4E75            	   216:     RTS
                            	   217: 
                            	   218: ; ------ Framebuffer Draw char 
                            	   219: 
                            	   220: DrawChar:
03:0000110C 48E7FCC0        	   221:     MOVEM.L D0-D5/A0-A1,-(SP)   * Tallenna kaikki käytettävät rekisterit
                            	   222: 
                            	   223:     * 1. LASKETAAN MERKIN OSOITE FONT_ROM-ALUEELLA
03:00001110 0280000000FF    	   224:     ANDI.L  #$000000FF,D0       * Varmistetaan, että D0:ssa on vain tavu
03:00001116 E788            	   225:     LSL.L   #3,D0               * Kerrotaan ASCII-koodi 8:lla (D0 = koodi * 8)
03:00001118 41F90008C000    	   226:     LEA     FONT_ROM,A0
03:0000111E D1C0            	   227:     ADDA.L  D0,A0               * A0 osoittaa nyt halutun merkin 8 tavun alkuun
                            	   228: 
                            	   229:     * 2. LASKETAAN KOHDEOSOITE FRAMEBUFFERISSA (VRAM)
                            	   230:     * Kaava: VRAM_START + (Y * 800) + X
03:00001120 43F900080000    	   231:     LEA     VRAM_START,A1
03:00001126 C4FC0320        	   232:     MULU.W  #800,D2             * D2 = Y * 800
03:0000112A D3C2            	   233:     ADDA.L  D2,A1               * A1 = VRAM + (Y * 800)
03:0000112C 02810000FFFF    	   234:     ANDI.L  #$0000FFFF,D1       * Varmistetaan X:n puhtaus
03:00001132 D3C1            	   235:     ADDA.L  D1,A1               * A1 osoittaa nyt pikseliin (X, Y)
                            	   236: 
                            	   237:     * 3. PIIRTOSILMUKKA (8 riviä)
03:00001134 383C0008        	   238:     MOVE.W  #8,D4               * Rivimäärä = 8
                            	   239: 
                            	   240: Char_Row_Loop:
03:00001138 1018            	   241:     MOVE.B  (A0)+,D0            * Luetaan fontin yksi rivitavu (8 bittiä)
03:0000113A 3A3C0008        	   242:     MOVE.W  #8,D5               * Sarakemäärä = 8 bittiä
                            	   243: 
                            	   244: Char_Bit_Loop:
03:0000113E E318            	   245:     ROL.B   #1,D0               * Pyöräytetään ylin bitti Carry-lippuun
03:00001140 6402            	   246:     BCC     Pixel_Off           * Jos Carry on 0, hypätään yli (tausta säilyy)
                            	   247: 
                            	   248:     * Jos bitti oli 1, piirretään pikseli halutulla värillä
03:00001142 1283            	   249:     MOVE.B  D3,(A1)
                            	   250: 
                            	   251: Pixel_Off:
03:00001144 5289            	   252:     ADDQ.L  #1,A1               * Siirrytään seuraavaan pikseliin oikealle (X + 1)
03:00001146 5345            	   253:     SUBQ.W  #1,D5
03:00001148 66F4            	   254:     BNE     Char_Bit_Loop       * Toistetaan rivin kaikille 8 bitille
                            	   255: 
                            	   256:     * Siirrytään seuraavan rivin alkuun framebufferissa
                            	   257:     * Piirrettiin 8 pikseliä, joten pitää hypätä yli: 800 - 8 = 792 pikseliä
03:0000114A 43E90318        	   258:     LEA     792(A1),A1
                            	   259: 
03:0000114E 5344            	   260:     SUBQ.W  #1,D4
03:00001150 66E6            	   261:     BNE     Char_Row_Loop       * Toistetaan kaikille 8 riville
                            	   262: 
03:00001152 4CDF033F        	   263:     MOVEM.L (SP)+,D0-D5/A0-A1   * Palautetaan rekisterit
03:00001156 4E75            	   264:     RTS
                            	   265: 
                            	   266: * =================================================================
                            	   267: * TULOSTETTAVA DATA
                            	   268: * =================================================================
                            	   269:             EVEN
                            	   270: 
03:00001158 00000000        	   271: StringPtr:    DS.L  1           * Osoitin tulostettavan merkkijonon nykyiseen merkkiin
                            	   272: 
03:0000115C 00              	   273: HexBuffer:    DS.B  4           
03:0000115D *
                            	   274: 
03:00001160 0000            	   275: CursorX:      DS.W  1           * UUSI: Nykyinen X-koordinaatti (0-799)
03:00001162 0000            	   276: CursorY:      DS.W  1           * UUSI: Nykyinen Y-koordinaatti (0-599)
                            	   277: 
                            	   278: MyMessage:
03:00001164 4D36386B204D7573	   279:     DC.B    "M68k Musashi keskeytystulostus toimii!",10,13,0
03:0000116C 61736869206B6573
03:00001174 6B65797479737475
03:0000117C 6C6F737475732074
03:00001184 6F696D696921
03:0000118A 0A
03:0000118B 0D
03:0000118C 00
                            	   280:     * 10 = Newline (\n), 13 = Carriage Return (\r), 0 = Null-terminaattori
                            	   281: 
                            	   282:             EVEN
                            	   283: 
                            	   284: VGA_Palette_Data:
                            	   285: * --- 16 VGA PERUSVÄRIÄ ---
03:0000118E 00000000        	   286:     DC.L    $00000000    * 0: Musta
03:00001192 000000AA        	   287:     DC.L    $000000AA    * 1: Sininen
03:00001196 0000AA00        	   288:     DC.L    $0000AA00    * 2: Vihreä
03:0000119A 0000AAAA        	   289:     DC.L    $0000AAAA    * 3: Syaani
03:0000119E 00AA0000        	   290:     DC.L    $00AA0000    * 4: Punainen
03:000011A2 00AA00AA        	   291:     DC.L    $00AA00AA    * 5: Magenta
03:000011A6 00AA5500        	   292:     DC.L    $00AA5500    * 6: Ruskea
03:000011AA 00AAAAAA        	   293:     DC.L    $00AAAAAA    * 7: Vaaleanharmaa
03:000011AE 00555555        	   294:     DC.L    $00555555    * 8: Tummanharmaa
03:000011B2 005555FF        	   295:     DC.L    $005555FF    * 9: Kirkas sininen
03:000011B6 0055FF55        	   296:     DC.L    $0055FF55    * 10: Kirkas vihreä
03:000011BA 0055FFFF        	   297:     DC.L    $0055FFFF    * 11: Kirkas syaani
03:000011BE 00FF5555        	   298:     DC.L    $00FF5555    * 12: Kirkas punainen
03:000011C2 00FF55FF        	   299:     DC.L    $00FF55FF    * 13: Kirkas magenta
03:000011C6 00FFFF55        	   300:     DC.L    $00FFFF55    * 14: Keltainen
03:000011CA 00FFFFFF        	   301:     DC.L    $00FFFFFF    * 15: Valkoinen
                            	   302: 
                            	   303: * --- SATEENKAARI JA VÄRISKAALAT (Värit 16-231) ---
03:000011CE 00000000        	   304:     DC.L    $00000000,$00000040,$00000080,$000000C0,$000000FF,$00004000
03:000011D2 00000040
