01:00001BA8 0C100030        	  1401: TN1	CMP.B	#'0',(A0)       is it less than zero?
01:00001BAC 6528            	  1402: 	BCS	TSNMRET 	if so, that's all
01:00001BAE 0C100039        	  1403: 	CMP.B	#'9',(A0)       is it greater than nine?
01:00001BB2 6222            	  1404: 	BHI	TSNMRET 	if so, return
01:00001BB4 B2BC0CCCCCCC    	  1405: 	CMP.L	#214748364,D1	see if there's room for new digit
01:00001BBA 6400FDC2        	  1406: 	BCC	QHOW		if not, we've overflowd
01:00001BBE 2001            	  1407: 	MOVE.L	D1,D0		quickly multiply result by 10
01:00001BC0 D281            	  1408: 	ADD.L	D1,D1
01:00001BC2 D281            	  1409: 	ADD.L	D1,D1
01:00001BC4 D280            	  1410: 	ADD.L	D0,D1
01:00001BC6 D281            	  1411: 	ADD.L	D1,D1
01:00001BC8 1018            	  1412: 	MOVE.B	(A0)+,D0	add in the new digit
01:00001BCA C0BC0000000F    	  1413: 	AND.L	#$F,D0
01:00001BD0 D280            	  1414: 	ADD.L	D0,D1
01:00001BD2 5242            	  1415: 	ADDQ	#1,D2		increment the no. of digits
01:00001BD4 60D2            	  1416: 	BRA	TN1
01:00001BD6 4E75            	  1417: TSNMRET RTS
                            	  1418: 
                            	  1419: *
                            	  1420: * ===== Skip over blanks in the text pointed to by A0.
                            	  1421: *
01:00001BD8 0C100020        	  1422: IGNBLK	CMP.B	#' ',(A0)       see if it's a space
01:00001BDC 6604            	  1423: 	BNE	IGBRET		if so, swallow it
01:00001BDE 5288            	  1424: IGB1	ADDQ.L	#1,A0		increment the text pointer
01:00001BE0 60F6            	  1425: 	BRA	IGNBLK
01:00001BE2 4E75            	  1426: IGBRET	RTS
                            	  1427: 
                            	  1428: *
                            	  1429: * ===== Convert the line of text in the input buffer to upper
                            	  1430: *	case (except for stuff between quotes).
                            	  1431: *
01:00001BE4 41F81CCC        	  1432: TOUPBUF LEA	BUFFER,A0	set up text pointer
01:00001BE8 4201            	  1433: 	CLR.B	D1		clear quote flag
01:00001BEA 1018            	  1434: TOUPB1	MOVE.B	(A0)+,D0	get the next text char.
01:00001BEC B03C000D        	  1435: 	CMP.B	#CR,D0		is it end of line?
01:00001BF0 6718            	  1436: 	BEQ	TOUPBRT 	if so, return
01:00001BF2 B03C0022        	  1437: 	CMP.B	#'"',D0         a double quote?
01:00001BF6 6714            	  1438: 	BEQ	DOQUO
01:00001BF8 B03C0027        	  1439: 	CMP.B	#'''',D0        or a single quote?
01:00001BFC 670E            	  1440: 	BEQ	DOQUO
01:00001BFE 4A01            	  1441: 	TST.B	D1		inside quotes?
01:00001C00 66E8            	  1442: 	BNE	TOUPB1		if so, do the next one
01:00001C02 6118            	  1443: 	BSR	TOUPPER 	convert to upper case
01:00001C04 1100            	  1444: 	MOVE.B	D0,-(A0)	store it
01:00001C06 5288            	  1445: 	ADDQ.L	#1,A0
01:00001C08 60E0            	  1446: 	BRA	TOUPB1		and go back for more
01:00001C0A 4E75            	  1447: TOUPBRT RTS
                            	  1448: 
01:00001C0C 4A01            	  1449: DOQUO	TST.B	D1		are we inside quotes?
01:00001C0E 6604            	  1450: 	BNE	DOQUO1
01:00001C10 1200            	  1451: 	MOVE.B	D0,D1		if not, toggle inside-quotes flag
01:00001C12 60D6            	  1452: 	BRA	TOUPB1
01:00001C14 B200            	  1453: DOQUO1	CMP.B	D0,D1		make sure we're ending proper quote
01:00001C16 66D2            	  1454: 	BNE	TOUPB1		if not, ignore it
01:00001C18 4201            	  1455: 	CLR.B	D1		else clear quote flag
01:00001C1A 60CE            	  1456: 	BRA	TOUPB1
                            	  1457: 
                            	  1458: *
                            	  1459: * ===== Convert the character in D0 to upper case
                            	  1460: *
01:00001C1C B03C0061        	  1461: TOUPPER CMP.B	#'a',D0         is it < 'a'?
01:00001C20 650A            	  1462: 	BCS	TOUPRET
01:00001C22 B03C007A        	  1463: 	CMP.B	#'z',D0         or > 'z'?
01:00001C26 6204            	  1464: 	BHI	TOUPRET
01:00001C28 903C0020        	  1465: 	SUB.B	#32,D0		if not, make it upper case
01:00001C2C 4E75            	  1466: TOUPRET RTS
                            	  1467: 
                            	  1468: *
                            	  1469: * 'CHKIO' checks the input. If there's no input, it will return
                            	  1470: * to the caller with the Z flag set. If there is input, the Z
                            	  1471: * flag is cleared and the input byte is in D0. However, if a
                            	  1472: * control-C is read, 'CHKIO' will warm-start BASIC and will not
                            	  1473: * return to the caller.
                            	  1474: *
01:00001C2E 6100F454        	  1475: CHKIO	BSR.W	INCH		get input if possible
01:00001C32 670A            	  1476: 	BEQ	CHKRET		if Zero, no input
01:00001C34 B03C0003        	  1477: 	CMP.B	#CTRLC,D0	is it control-C?
01:00001C38 6604            	  1478: 	BNE	CHKRET		if not
01:00001C3A 6000F56E        	  1479: 	BRA.W	WSTART		if so, do a warm start
01:00001C3E 4E75            	  1480: CHKRET	RTS
                            	  1481: 
                            	  1482: *
                            	  1483: * ===== Display a CR-LF sequence
                            	  1484: *
01:00001C40 4DF81C98        	  1485: CRLF	LEA	CLMSG,A6
                            	  1486: 
                            	  1487: *
                            	  1488: * ===== Display a zero-ended string pointed to by register A6
                            	  1489: *
01:00001C44 101E            	  1490: PRMESG	MOVE.B	(A6)+,D0	get the char.
01:00001C46 6706            	  1491: 	BEQ	PRMRET		if it's zero, we're done
01:00001C48 6100F422        	  1492: 	BSR	OUTCH		else display it
01:00001C4C 60F6            	  1493: 	BRA	PRMESG
01:00001C4E 4E75            	  1494: PRMRET	RTS
