                            	  1112: *
                            	  1113: *******************************************************************
                            	  1114: *
                            	  1115: * *** GETLN *** FNDLN (& friends) ***
                            	  1116: *
                            	  1117: * 'GETLN' reads in input line into 'BUFFER'. It first prompts with
                            	  1118: * the character in D0 (given by the caller), then it fills the
                            	  1119: * buffer and echos. It ignores LF's but still echos
                            	  1120: * them back. Control-H is used to delete the last character
                            	  1121: * entered (if there is one), and control-X is used to delete the
                            	  1122: * whole line and start over again. CR signals the end of a line,
                            	  1123: * and causes 'GETLN' to return.
                            	  1124: *
                            	  1125: * 'FNDLN' finds a line with a given line no. (in D1) in the
                            	  1126: * text save area.  A1 is used as the text pointer. If the line
                            	  1127: * is found, A1 will point to the beginning of that line
                            	  1128: * (i.e. the high byte of the line no.), and flags are NC & Z.
                            	  1129: * If that line is not there and a line with a higher line no.
                            	  1130: * is found, A1 points there and flags are NC & NZ. If we reached
                            	  1131: * the end of the text save area and cannot find the line, flags
                            	  1132: * are C & NZ.
                            	  1133: * 'FNDLN' will initialize A1 to the beginning of the text save
                            	  1134: * area to start the search. Some other entries of this routine
                            	  1135: * will not initialize A1 and do the search.
                            	  1136: * 'FNDLNP' will start with A1 and search for the line no.
                            	  1137: * 'FNDNXT' will bump A1 by 2, find a CR and then start search.
                            	  1138: * 'FNDSKP' uses A1 to find a CR, and then starts the search.
                            	  1139: *
01:00001986 6100F6E4        	  1140: GETLN	BSR	OUTCH		display the prompt
01:0000198A 103C0020        	  1141: 	MOVE.B	#' ',D0         and a space
01:0000198E 6100F6DC        	  1142: 	BSR	OUTCH
01:00001992 41F81CCC        	  1143: 	LEA	BUFFER,A0	A0 is the buffer pointer
01:00001996 61000296        	  1144: GL1	BSR.W	CHKIO		check keyboard
01:0000199A 67FA            	  1145: 	BEQ	GL1		wait for a char. to come in
01:0000199C B03C0008        	  1146: 	CMP.B	#CTRLH,D0	delete last character?
01:000019A0 6724            	  1147: 	BEQ	GL3		if so
01:000019A2 B03C0018        	  1148: 	CMP.B	#CTRLX,D0	delete the whole line?
01:000019A6 6740            	  1149: 	BEQ	GL4		if so
01:000019A8 B03C000D        	  1150: 	CMP.B	#CR,D0		accept a CR
01:000019AC 6706            	  1151: 	BEQ	GL2
01:000019AE B03C0020        	  1152: 	CMP.B	#' ',D0         if other control char., discard it
01:000019B2 65E2            	  1153: 	BCS	GL1
01:000019B4 10C0            	  1154: GL2	MOVE.B	D0,(A0)+	save the char.
01:000019B6 6100F6B4        	  1155: 	BSR	OUTCH		echo the char back out
01:000019BA B03C000D        	  1156: 	CMP.B	#CR,D0		if it's a CR, end the line
01:000019BE 6756            	  1157: 	BEQ	GL7
01:000019C0 B0FC1D1B        	  1158: 	CMP.L	#(BUFFER+BUFLEN-1),A0	any more room?
01:000019C4 65D0            	  1159: 	BCS	GL1		yes: get some more, else delete last char.
01:000019C6 103C0008        	  1160: GL3	MOVE.B	#CTRLH,D0	delete a char. if possible
01:000019CA 6100F6A0        	  1161: 	BSR	OUTCH
01:000019CE 103C0020        	  1162: 	MOVE.B	#' ',D0
01:000019D2 6100F698        	  1163: 	BSR	OUTCH
01:000019D6 B0FC1CCC        	  1164: 	CMP.L	#BUFFER,A0	any char.'s left?
01:000019DA 63BA            	  1165: 	BLS	GL1		if not
01:000019DC 103C0008        	  1166: 	MOVE.B	#CTRLH,D0	if so, finish the BS-space-BS sequence
01:000019E0 6100F68A        	  1167: 	BSR	OUTCH
01:000019E4 5388            	  1168: 	SUBQ.L	#1,A0		decrement the text pointer
01:000019E6 60AE            	  1169: 	BRA	GL1		back for more
01:000019E8 2208            	  1170: GL4	MOVE.L	A0,D1		delete the whole line
01:000019EA 92BC00001CCC    	  1171: 	SUB.L	#BUFFER,D1	figure out how many backspaces we need
01:000019F0 671E            	  1172: 	BEQ	GL6		if none needed, branch
01:000019F2 5341            	  1173: 	SUBQ	#1,D1		adjust for DBRA
01:000019F4 103C0008        	  1174: GL5	MOVE.B	#CTRLH,D0	and display BS-space-BS sequences
01:000019F8 6100F672        	  1175: 	BSR	OUTCH
01:000019FC 103C0020        	  1176: 	MOVE.B	#' ',D0
01:00001A00 6100F66A        	  1177: 	BSR	OUTCH
01:00001A04 103C0008        	  1178: 	MOVE.B	#CTRLH,D0
01:00001A08 6100F662        	  1179: 	BSR	OUTCH
01:00001A0C 51C9FFE6        	  1180: 	DBRA	D1,GL5
01:00001A10 41F81CCC        	  1181: GL6	LEA	BUFFER,A0	reinitialize the text pointer
01:00001A14 6080            	  1182: 	BRA	GL1		and go back for more
01:00001A16 103C000A        	  1183: GL7	MOVE.B	#LF,D0		echo a LF for the CR
01:00001A1A 6100F650        	  1184: 	BSR	OUTCH
01:00001A1E 4E75            	  1185: 	RTS
