01:00001A68 6710            	  1237: 	BEQ	PP1
01:00001A6A 21DF1CB0        	  1238: 	MOVE.L	(SP)+,LOPINC	if not zero, restore the rest
01:00001A6E 21DF1CB4        	  1239: 	MOVE.L	(SP)+,LOPLMT
