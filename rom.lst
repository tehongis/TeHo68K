                            	  1257: *
                            	  1258: *******************************************************************
                            	  1259: *
                            	  1260: * *** PRTSTG *** QTSTG *** PRTNUM *** PRTLN ***
                            	  1261: *
                            	  1262: * 'PRTSTG' prints a string pointed to by A1. It stops printing
                            	  1263: * and returns to the caller when either a CR is printed or when
                            	  1264: * the next byte is the same as what was passed in D0 by the
                            	  1265: * caller.
                            	  1266: *
                            	  1267: * 'QTSTG' looks for an underline (back-arrow on some systems),
                            	  1268: * single-quote, or double-quote.  If none of these are found, returns
                            	  1269: * to the caller.  If underline, outputs a CR without a LF.  If single
                            	  1270: * or double quote, prints the quoted string and demands a matching
                            	  1271: * end quote.  After the printing, the next 2 bytes of the caller are
                            	  1272: * skipped over (usually a short branch instruction).
                            	  1273: *
                            	  1274: * 'PRTNUM' prints the 32 bit number in D1, leading blanks are added if
                            	  1275: * needed to pad the number of spaces to the number in D4.
                            	  1276: * However, if the number of digits is larger than the no. in
                            	  1277: * D4, all digits are printed anyway. Negative sign is also
                            	  1278: * printed and counted in, positive sign is not.
                            	  1279: *
                            	  1280: * 'PRTLN' prints the saved text line pointed to by A1
                            	  1281: * with line no. and all.
                            	  1282: *
01:00001AA2 1200            	  1283: PRTSTG	MOVE.B	D0,D1		save the stop character
01:00001AA4 1019            	  1284: PS1	MOVE.B	(A1)+,D0	get a text character
01:00001AA6 B200            	  1285: 	CMP.B	D0,D1		same as stop character?
01:00001AA8 6712            	  1286: 	BEQ	PRTRET		if so, return
01:00001AAA 6100F5C0        	  1287: 	BSR	OUTCH		display the char.
01:00001AAE B03C000D        	  1288: 	CMP.B	#CR,D0		is it a C.R.?
01:00001AB2 66F0            	  1289: 	BNE	PS1		no, go back for more
01:00001AB4 103C000A        	  1290: 	MOVE.B	#LF,D0		yes, add a L.F.
01:00001AB8 6100F5B2        	  1291: 	BSR	OUTCH
01:00001ABC 4E75            	  1292: PRTRET	RTS			then return
