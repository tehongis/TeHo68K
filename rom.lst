                            	    26: 
                            	    27: CR	EQU	$0D		ASCII equates
                            	    28: LF	EQU	$0A
                            	    29: TAB	EQU	$09
                            	    30: CTRLC	EQU	$03
                            	    31: CTRLH	EQU	$08
                            	    32: CTRLS	EQU	$13
                            	    33: CTRLX	EQU	$18
                            	    34: 
                            	    35: BUFLEN	EQU	80		length of keyboard input buffer
                            	    36: 
01:00001164 4EF81180        	    37: 		JMP		CSTART
                            	    38: * Standard jump table. You can change these addresses if you are
                            	    39: * customizing this interpreter for a different environment.
                            	    40: 
                            	    41: *
01:00001168 60000016        	    42: START	BRA.W	CSTART		Cold Start entry point
                            	    43: *GOWARM	BRA.W	WSTART		Warm Start entry point
                            	    44: *OUTCH	BRA.W	OUTC		Jump to character-out routine
                            	    45: *INCH	BRA.W	INC		Jump to character-in routine
01:0000116C 6000FF42        	    46: GOAUXO	BRA.W	AUXOUT		Jump to auxiliary-out routine
01:00001170 6000FF56        	    47: GOAUXI	BRA.W	AUXIN		Jump to auxiliary-in routine
01:00001174 60000ADA        	    48: GOBYE	BRA.W	BYEBYE		Jump to monitor, DOS, etc.
                            	    49: *
                            	    50: 
                            	    51: * Modifiable system constants:
                            	    52: *
01:00001178 00001D1C        	    53: TXTBGN	DC.L	TXT		beginning of program memory
01:0000117C 0003F000        	    54: ENDMEM	DC.L	$3f000		end of available memory
                            	    55: *
                            	    56: * The main interpreter starts here:
                            	    57: *
01:00001180 2E78117C        	    58: CSTART	MOVE.L	ENDMEM,SP	initialize stack pointer
01:00001184 4DF81C56        	    59: 	LEA	INITMSG,A6	tell who we are
01:00001188 61000ABA        	    60: 	BSR.W	PRMESG
01:0000118C 21F811781CC0    	    61: 	MOVE.L	TXTBGN,TXTUNF	init. end-of-program pointer
01:00001192 2038117C        	    62: 	MOVE.L	ENDMEM,D0	get address of end of memory
01:00001196 90BC00000800    	    63: 	SUB.L	#2048,D0	reserve 2K for the stack
01:0000119C 21C01CC8        	    64: 	MOVE.L	D0,STKLMT
01:000011A0 90BC0000006C    	    65: 	SUB.L	#108,D0 	reserve variable area (27 long words)
01:000011A6 21C01CC4        	    66: 	MOVE.L	D0,VARBGN
01:000011AA 7000            	    67: WSTART	CLR.L	D0		initialize internal variables
01:000011AC 21C01CAC        	    68: 	MOVE.L	D0,LOPVAR
01:000011B0 21C01CA4        	    69: 	MOVE.L	D0,STKGOS
01:000011B4 21C01CA0        	    70: 	MOVE.L	D0,CURRNT	current line number pointer = 0
01:000011B8 2E78117C        	    71: 	MOVE.L	ENDMEM,SP	init S.P. again, just in case
01:000011BC 4DF81C7C        	    72: 	LEA	OKMSG,A6	display "OK"
01:000011C0 61000A82        	    73: 	BSR.W	PRMESG
01:000011C4 103C003E        	    74: ST3	MOVE.B	#'>',D0         Prompt with a '>' and
01:000011C8 610007BC        	    75: 	BSR.W	GETLN		read a line.
01:000011CC 61000A16        	    76: 	BSR.W	TOUPBUF 	convert to upper case
01:000011D0 2848            	    77: 	MOVE.L	A0,A4		save pointer to end of line
01:000011D2 41F81CCC        	    78: 	LEA	BUFFER,A0	point to the beginning of line
01:000011D6 610009CA        	    79: 	BSR.W	TSTNUM		is there a number there?
01:000011DA 610009FC        	    80: 	BSR.W	IGNBLK		skip trailing blanks
01:000011DE 4A41            	    81: 	TST	D1		does line no. exist? (or nonzero?)
01:000011E0 6700011A        	    82: 	BEQ.W	DIRECT		if not, it's a direct statement
01:000011E4 B2BC0000FFFF    	    83: 	CMP.L	#$FFFF,D1	see if line no. is <= 16 bits
01:000011EA 64000792        	    84: 	BCC.W	QHOW		if not, we've overflowed
01:000011EE 1101            	    85: 	MOVE.B	D1,-(A0)	store the binary line no.
01:000011F0 E059            	    86: 	ROR	#8,D1		(Kludge to store a word on a
01:000011F2 1101            	    87: 	MOVE.B	D1,-(A0)	possible byte boundary)
01:000011F4 E159            	    88: 	ROL	#8,D1
01:000011F6 61000828        	    89: 	BSR.W	FNDLN		find this line in save area
01:000011FA 2A49            	    90: 	MOVE.L	A1,A5		save possible line pointer
01:000011FC 6612            	    91: 	BNE	ST4		if not found, insert
01:000011FE 61000846        	    92: 	BSR.W	FNDNXT		find the next line (into A1)
01:00001202 244D            	    93: 	MOVE.L	A5,A2		pointer to line to be deleted
01:00001204 26781CC0        	    94: 	MOVE.L	TXTUNF,A3	points to top of save area
01:00001208 61000846        	    95: 	BSR.W	MVUP		move up to delete
01:0000120C 21CA1CC0        	    96: 	MOVE.L	A2,TXTUNF	update the end pointer
01:00001210 200C            	    97: ST4	MOVE.L	A4,D0		calculate the length of new line
01:00001212 9088            	    98: 	SUB.L	A0,D0
01:00001214 B0BC00000003    	    99: 	CMP.L	#3,D0		is it just a line no. & CR?
01:0000121A 67A8            	   100: 	BEQ	ST3		if so, it was just a delete
01:0000121C 26781CC0        	   101: 	MOVE.L	TXTUNF,A3	compute new end
01:00001220 2C4B            	   102: 	MOVE.L	A3,A6
01:00001222 D7C0            	   103: 	ADD.L	D0,A3
01:00001224 20381CC4        	   104: 	MOVE.L	VARBGN,D0	see if there's enough room
01:00001228 B08B            	   105: 	CMP.L	A3,D0
01:0000122A 6300074A        	   106: 	BLS.W	QSORRY		if not, say so
01:0000122E 21CB1CC0        	   107: 	MOVE.L	A3,TXTUNF	if so, store new end position
01:00001232 224E            	   108: 	MOVE.L	A6,A1		points to old unfilled area
01:00001234 244D            	   109: 	MOVE.L	A5,A2		points to beginning of move area
01:00001236 61000822        	   110: 	BSR.W	MVDOWN		move things out of the way
01:0000123A 2248            	   111: 	MOVE.L	A0,A1		set up to do the insertion
01:0000123C 244D            	   112: 	MOVE.L	A5,A2
01:0000123E 264C            	   113: 	MOVE.L	A4,A3
01:00001240 6100080E        	   114: 	BSR.W	MVUP		do it
01:00001244 6000FF7E        	   115: 	BRA	ST3		go back and get another line
