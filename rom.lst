Source: "HAL.i"
                            	     1: ; =============================================================================
                            	     2: ; MINITIETOKONEEN HAL (HARDWARE ABSTRACTION LAYER) MÄÄRITTELYT
                            	     3: ; Kääntäjäyhteensopivuus: vasm68k_mot (Motorola Syntax)
                            	     4: ; Syntaksisäännöt: LABELIT ISROLLA, käskyt ja rekisterit pienellä.
                            	     5: ; =============================================================================
                            	     6: 
                            	     7: SYSTEM_MEM_SIZE equ $100000
                            	     8: 
                            	     9: VRAM_START    equ   $00080000
                            	    10: VRAM_X        equ   320
                            	    11: VRAM_Y        equ   256
                            	    12: VRAM_SIZE     equ   (VRAM_X*VRAM_Y)
                            	    13: PALETTE_START equ   $00088000
                            	    14: PALETTE_SIZE  equ   (256*4)
                            	    15: FONT_ROM      EQU   $0008c000
                            	    16: 
                            	    17: ; Virtuaalisen UART:n rekisterit
                            	    18: UART_IN_ADDR  equ   $0008F000
                            	    19: UART_OUT_ADDR equ   $0008F004
                            	    20: 

Source: "asm/rom_monitor.asm"
                            	     6: 
                            	     7: * =================================================================
                            	     8: * VEKTORITAULUKKO (Alkaa osoitteesta $00000000)
                            	     9: * =================================================================
                            	    10:     ORG     $00000000
00:00000000 00010000        	    11:     DC.L    $00010000           * Alustus: Pinon huippu (Stack Pointer)
00:00000004 00001000        	    12:     DC.L    Main                * Alustus: Ohjelman aloitusosoite (PC)
                            	    13: 
                            	    14:     ORG     $00000064           * IRQ 1 Autovector (Näppäimistö sisään)
01:00000064 00001076        	    15:     DC.L    Keyboard_ISR
                            	    16: 
                            	    17:     ORG     $00000068           * IRQ 2 Autovector (Tulostus ulos)
02:00000068 0000104E        	    18:     DC.L    Output_ISR
                            	    19: 
                            	    20: * =================================================================
                            	    21: * PÄÄOHJELMA
                            	    22: * =================================================================
                            	    23:               ORG   $00001000   * Ohjelmakoodin paikka RAM-muistissa
                            	    24: Main:
                            	    25: 
                            	    26: ; --- Init_Palette
03:00001000 41F8117E        	    27:     LEA     VGA_Palette_Data,A0  * Osoitin tämän taulukon alkuun
03:00001004 43F900088000    	    28:     LEA     PALETTE_START,A1           * Osoitin emuloituun palettimuistiin
03:0000100A 303C0100        	    29:     MOVE.W  #256,D0              * Looppi pyörii 256 kertaa (kaikki värit)
                            	    30: .paletteLoop
03:0000100E 22D8            	    31:     MOVE.L  (A0)+,(A1)+          * Kopioidaan väri ($00RRGGBB) palettiin
03:00001010 5340            	    32:     SUBQ.W  #1,D0
03:00001012 66FA            	    33:     BNE     .paletteLoop
                            	    34: 
                            	    35:     * 1. Alustetaan muuttujat nollaksi
03:00001014 42B81148        	    36:     CLR.L   StringPtr
                            	    37: 
                            	    38:     * 3. KUTSUTAAN TULOSTUSRUTIINIA: Tulostetaan haluttu viesti
03:00001018 41F81154        	    39:     LEA     MyMessage,A0        * Ladataan viestin osoite A0-rekisteriin
03:0000101C 6116            	    40:     BSR     PrintString         * Kutsutaan tulostuksen käynnistystä
                            	    41: 
                            	    42:     * 2. Sallitaan keskeytykset tasoilla 1 ja 2 (SR interrupt mask = 0)
03:0000101E 027CF8FF        	    43:     ANDI.W  #$F8FF,SR
                            	    44: 
                            	    45:     * 3. KUTSUTAAN TULOSTUSRUTIINIA: Tulostetaan haluttu viesti
03:00001022 42B81148        	    46:     CLR.L   StringPtr
03:00001026 41F81154        	    47:     LEA     MyMessage,A0        * Ladataan viestin osoite A0-rekisteriin
03:0000102A 7602            	    48:     move.l  #$2,d3
03:0000102C 6100008A        	    49:     BSR     PrintStringFB         * Kutsutaan tulostuksen käynnistystä
                            	    50: 
                            	    51: Loop:
03:00001030 4EF81030        	    52:     JMP     Loop
                            	    53: 
                            	    54: 
                            	    55: * =================================================================
                            	    56: * PALETIN LATAUSRUTIINI
                            	    57: * =================================================================
                            	    58: 
                            	    59: * =================================================================
                            	    60: * ALIOHJELMA: PrintString (Käynnistää tulostusketjun)
                            	    61: * Sisääntulo: A0 = Tulostettavan merkkijonon osoite
                            	    62: * =================================================================
                            	    63: PrintString:
03:00001034 48E78080        	    64:     MOVEM.L D0/A0,-(SP)         * Tallenna käytettävät rekisterit
                            	    65: 
                            	    66:     * Tarkistetaan heti, onko jono tyhjä (ensimmäinen merkki nolla)
03:00001038 1010            	    67:     MOVE.B  (A0),D0
03:0000103A 670C            	    68:     BEQ     Print_Done          * Jos on nolla, älä tee mitään
                            	    69: 
                            	    70:     * Asetetaan osoitin valmiiksi seuraavaa merkkiä varten (A0 + 1)
03:0000103C 5288            	    71:     ADDQ.L  #1,A0
03:0000103E 21C81148        	    72:     MOVE.L  A0,StringPtr
                            	    73: 
                            	    74:     * Kirjoitetaan ensimmäinen merkki suoraan UART:iin.
                            	    75:     * Tämä saa C-koodin tulostamaan sen ja herättämään ensimmäisen IRQ 2:n.
03:00001042 13C00008F004    	    76:     MOVE.B  D0,UART_OUT_ADDR
                            	    77: 
                            	    78: Print_Done:
03:00001048 4CDF0101        	    79:     MOVEM.L (SP)+,D0/A0         * Palauta rekisterit
03:0000104C 4E75            	    80:     RTS
                            	    81: 
                            	    82: * =================================================================
                            	    83: * IRQ 2: TULOSTUKSEN KESKEYTYSRUTIINI (MC68000-YHTEENSOPIVA)
                            	    84: * =================================================================
                            	    85: Output_ISR:
03:0000104E 48E78080        	    86:     MOVEM.L D0/A0,-(SP)         * Tallenna rekisterit suojaukseen
                            	    87: 
03:00001052 20781148        	    88:     MOVE.L  StringPtr,A0        * Ladataan nykyinen teksti-osoitin
                            	    89:     
                            	    90:     * KORJAUS: Alkuperäinen 68000 ei tue TST.L A0 -käskyä.
                            	    91:     * Verrataan osoiterekisteriä arvoon 0 CMPA-käskyllä (asettaa Z-lipun, jos NULL).
03:00001056 B0FC0000        	    92:     CMPA.W  #0,A0               
03:0000105A 6714            	    93:     BEQ     ISR_Done            * Jos on nolla, ei aktiivista viestiä -> poistu
                            	    94: 
03:0000105C 1018            	    95:     MOVE.B  (A0)+,D0            * Luetaan merkki ja siirretään osoitinta eteenpäin
03:0000105E 670C            	    96:     BEQ     Message_Finished    * Jos merkki on $00, viesti loppui
                            	    97: 
                            	    98:     * Päivitetään uusi osoitin muistiin seuraavaa keskeytystä varten
03:00001060 21C81148        	    99:     MOVE.L  A0,StringPtr        
                            	   100:     
                            	   101:     * Lähetetään merkki laitteelle (C-puoli tulostace ja nostaa uuden IRQ 2:n)
03:00001064 13C00008F004    	   102:     MOVE.B  D0,UART_OUT_ADDR
03:0000106A 6004            	   103:     BRA     ISR_Done
                            	   104: 
                            	   105: Message_Finished:
03:0000106C 42B81148        	   106:     CLR.L   StringPtr           * Nollataan osoitin merkiksi siitä, että viesti päättyi
                            	   107: 
                            	   108: ISR_Done:
03:00001070 4CDF0101        	   109:     MOVEM.L (SP)+,D0/A0         * Palauta rekisterit
03:00001074 4E73            	   110:     RTE                         * Paluu keskeytyksestä
                            	   111: 
                            	   112: * =================================================================
                            	   113: * IRQ 1: NÄPPÄIMISTÖN KESKEYTYSRUTIINI (MUOKATTU HEKSATULOSTUKSELLE)
                            	   114: * =================================================================
                            	   115: Keyboard_ISR:
03:00001076 48E7E080        	   116:     MOVEM.L D0-D2/A0,-(SP)      * Tallenna kaikki käytettävät rekisterit
                            	   117: 
03:0000107A 10390008F000    	   118:     MOVE.B  (UART_IN_ADDR),D0        * 1. Luetaan saapunut näppäinkoodi D0-rekisteriin
03:00001080 41F8114C        	   119:     LEA     HexBuffer,A0        * 2. Otetaan puskurin osoite A0-rekisteriin
                            	   120: 
                            	   121:     * --- YLEMPI HEX-MERKKI (Ylemmät 4 bittiä) ---
03:00001084 1200            	   122:     MOVE.B  D0,D1               * Otetaan kopio koodista D1-rekisteriin
03:00001086 E809            	   123:     LSR.B   #4,D1               * Siirretään yläbitit alabiteiksi (esim. $41 -> $04)
03:00001088 6120            	   124:     BSR     ConvertNibble       * Muutetaan numeroksi/kirjaimeksi ASCII-muotoon
03:0000108A 10C1            	   125:     MOVE.B  D1,(A0)+            * Tallennetaan puskurin ensimmäiseksi merkiksi
                            	   126: 
                            	   127:     * --- ALEMPI HEX-MERKKI (Alemmat 4 bittiä) ---
03:0000108C 1200            	   128:     MOVE.B  D0,D1               * Otetaan uusi kopio koodista D1-rekisteriin
03:0000108E 0201000F        	   129:     ANDI.B  #$0F,D1             * Maskataan yläbitit pois (esim. $41 -> $01)
03:00001092 6116            	   130:     BSR     ConvertNibble       * Muutetaan ASCII-muotoon
03:00001094 10C1            	   131:     MOVE.B  D1,(A0)+            * Tallennetaan puskurin toiseksi merkiksi
                            	   132: 
                            	   133:     * --- LOPPUMERKIT ---
03:00001096 10FC0020        	   134:     MOVE.B  #32,(A0)+           * Lisätään välilyönti (ASCII 32) heksalukujen väliin
03:0000109A 10BC0000        	   135:     MOVE.B  #0,(A0)             * Lisätään nollaterminaattori merkkijonon loppuun ($00)
                            	   136: 
                            	   137:     * --- TULOSTUS ---
03:0000109E 41F8114C        	   138:     LEA     HexBuffer,A0        * Ladataan puskurin alkuosoite takaisin A0:aan
03:000010A2 6190            	   139:     BSR     PrintString         * Kutsutaan valmista tulostusrutiinia!
                            	   140: 
03:000010A4 4CDF0107        	   141:     MOVEM.L (SP)+,D0-D2/A0      * Palautetaan rekisterit
03:000010A8 4E73            	   142:     RTE                         * Paluu keskeytyksestä
                            	   143: 
                            	   144: * =================================================================
                            	   145: * APURUTIINI: ConvertNibble (Muuntaa 4 bittiä ASCII-heksamerkiksi)
                            	   146: * Sisääntulo: D1 = Alimmat 4 bittiä sisältävät muunnettavan arvon (0-15)
                            	   147: * Ulostulo:   D1 = Valmis ASCII-merkki ('0'-'9' tai 'A'-'F')
                            	   148: * =================================================================
                            	   149: ConvertNibble:
03:000010AA 0C01000A        	   150:     CMPI.B  #10,D1              * Onko arvo alle 10 (0-9)?
03:000010AE 6D02            	   151:     BLT     IsDigit             * Jos on, hypätään suoraan numeron käsittelyyn
                            	   152:     
                            	   153:     * Jos arvo on 10-15 (A-F):
03:000010B0 5E01            	   154:     ADDQ.B  #7,D1               * Lisätään erotus numeroiden ja kirjainten välillä ASCII-taulukossa
                            	   155: IsDigit:
03:000010B2 06010030        	   156:     ADDI.B  #$30,D1             * Lisätään '0'-merkin ASCII-arvo ($30)
03:000010B6 4E75            	   157:     RTS
                            	   158: 
                            	   159: ; --------- Framebuffer printString
                            	   160: * =================================================================
                            	   161: * ALIOHJELMA: PrintStringFB (Framebuffer/VRAM-versio)
                            	   162: * Sisääntulo: A0 = Null-terminoidun merkkijonon osoite
                            	   163: *             D3.B = Tekstin väri (VGA-paletin indeksi)
                            	   164: * =================================================================
                            	   165: PrintStringFB:
03:000010B8 48E7E080        	   166:     MOVEM.L D0-D2/A0,-(SP)      * Tallenna käytettävät rekisterit
                            	   167: 
                            	   168: Print_Char_Loop:
03:000010BC 1018            	   169:     MOVE.B  (A0)+,D0            * Lue merkki ja siirrä osoitinta eteenpäin
03:000010BE 6736            	   170:     BEQ     Print_DoneFB         * Jos merkki on 0 (loppumerkki), lopeta
                            	   171: 
                            	   172:     * TARKISTETAAN RIVINVAIHTO (ASCII 10 / Newline)
03:000010C0 0C00000A        	   173:     CMPI.B  #10,D0
03:000010C4 6720            	   174:     BEQ     Handle_Newline
                            	   175: 
                            	   176:     * TAVALLISEN MERKIN TULOSTUS
                            	   177:     * Ladataan kursorin nykyiset koordinaatit DrawChar-aliohjelmalle
03:000010C6 32381150        	   178:     MOVE.W  (CursorX),D1
03:000010CA 34381152        	   179:     MOVE.W  (CursorY),D2
                            	   180:     
03:000010CE 612C            	   181:     BSR     DrawChar            * Piirretään merkki ruudulle!
                            	   182: 
                            	   183:     * Siirretään kursorikohdistinta 8 pikseliä oikealle seuraavaa merkkiä varten
03:000010D0 5041            	   184:     ADDQ.W  #8,D1
03:000010D2 0C410140        	   185:     CMPI.W  #320,D1             * Saavutettiinko ruudun oikea reuna?
03:000010D6 6D04            	   186:     BLT     Save_Cursor_X
                            	   187:     
                            	   188:     * Jos reuna saavutettiin, tehdään automaattinen rivinvaihto
03:000010D8 4241            	   189:     CLR.W  D1                  * X = 0
03:000010DA 5042            	   190:     ADDQ.W  #8,D2               * Y = Y + 8
                            	   191: 
                            	   192: Save_Cursor_X:
03:000010DC 31C11150        	   193:     MOVE.W  D1,(CursorX)
03:000010E0 31C21152        	   194:     MOVE.W  D2,(CursorY)
03:000010E4 60D6            	   195:     BRA     Print_Char_Loop     * Siirrytään seuraavaan merkkiin
                            	   196: 
                            	   197: Handle_Newline:
                            	   198:     * Siirretään kursori seuraavan rivin alkuun (X=0, Y=Y+8)
03:000010E6 42781150        	   199:     CLR.W   (CursorX)
03:000010EA 34381152        	   200:     MOVE.W  (CursorY),D2
03:000010EE 5042            	   201:     ADDQ.W  #8,D2
                            	   202:     
                            	   203:     * Valinnainen: Tähän voi lisätä tarkistuksen jos Y > 592 (ruudun rullaus/scroll),
                            	   204:     * mutta pidetään se aluksi yksinkertaisena.
03:000010F0 31C21152        	   205:     MOVE.W  D2,(CursorY)
03:000010F4 60C6            	   206:     BRA     Print_Char_Loop     * Jatgetaan merkkijonon läpikäyntiä
                            	   207: 
                            	   208: Print_DoneFB:
03:000010F6 4CDF0107        	   209:     MOVEM.L (SP)+,D0-D2/A0      * Palauta rekisterit
03:000010FA 4E75            	   210:     RTS
                            	   211: 
                            	   212: ; ------ Framebuffer Draw char 
                            	   213: 
                            	   214: DrawChar:
03:000010FC 48E7FCC0        	   215:     MOVEM.L D0-D5/A0-A1,-(SP)   * Tallenna kaikki käytettävät rekisterit
                            	   216: 
                            	   217:     * 1. LASKETAAN MERKIN OSOITE FONT_ROM-ALUEELLA
03:00001100 0280000000FF    	   218:     ANDI.L  #$000000FF,D0       * Varmistetaan, että D0:ssa on vain tavu
03:00001106 E788            	   219:     LSL.L   #3,D0               * Kerrotaan ASCII-koodi 8:lla (D0 = koodi * 8)
03:00001108 41F90008C000    	   220:     LEA     FONT_ROM,A0
03:0000110E D1C0            	   221:     ADDA.L  D0,A0               * A0 osoittaa nyt halutun merkin 8 tavun alkuun
                            	   222: 
                            	   223:     * 2. LASKETAAN KOHDEOSOITE FRAMEBUFFERISSA (VRAM)
                            	   224:     * Kaava: VRAM_START + (Y * 800) + X
03:00001110 43F900080000    	   225:     LEA     VRAM_START,A1
03:00001116 C4FC0320        	   226:     MULU.W  #800,D2             * D2 = Y * 800
03:0000111A D3C2            	   227:     ADDA.L  D2,A1               * A1 = VRAM + (Y * 800)
03:0000111C 02810000FFFF    	   228:     ANDI.L  #$0000FFFF,D1       * Varmistetaan X:n puhtaus
03:00001122 D3C1            	   229:     ADDA.L  D1,A1               * A1 osoittaa nyt pikseliin (X, Y)
                            	   230: 
                            	   231:     * 3. PIIRTOSILMUKKA (8 riviä)
03:00001124 383C0008        	   232:     MOVE.W  #8,D4               * Rivimäärä = 8
                            	   233: 
                            	   234: Char_Row_Loop:
03:00001128 1018            	   235:     MOVE.B  (A0)+,D0            * Luetaan fontin yksi rivitavu (8 bittiä)
03:0000112A 3A3C0008        	   236:     MOVE.W  #8,D5               * Sarakemäärä = 8 bittiä
                            	   237: 
                            	   238: Char_Bit_Loop:
03:0000112E E318            	   239:     ROL.B   #1,D0               * Pyöräytetään ylin bitti Carry-lippuun
03:00001130 6402            	   240:     BCC     Pixel_Off           * Jos Carry on 0, hypätään yli (tausta säilyy)
                            	   241: 
                            	   242:     * Jos bitti oli 1, piirretään pikseli halutulla värillä
03:00001132 1283            	   243:     MOVE.B  D3,(A1)
                            	   244: 
                            	   245: Pixel_Off:
03:00001134 5289            	   246:     ADDQ.L  #1,A1               * Siirrytään seuraavaan pikseliin oikealle (X + 1)
03:00001136 5345            	   247:     SUBQ.W  #1,D5
03:00001138 66F4            	   248:     BNE     Char_Bit_Loop       * Toistetaan rivin kaikille 8 bitille
                            	   249: 
                            	   250:     * Siirrytään seuraavan rivin alkuun framebufferissa
                            	   251:     * Piirrettiin 8 pikseliä, joten pitää hypätä yli: 800 - 8 = 792 pikseliä
03:0000113A 43E90318        	   252:     LEA     792(A1),A1
                            	   253: 
03:0000113E 5344            	   254:     SUBQ.W  #1,D4
03:00001140 66E6            	   255:     BNE     Char_Row_Loop       * Toistetaan kaikille 8 riville
                            	   256: 
03:00001142 4CDF033F        	   257:     MOVEM.L (SP)+,D0-D5/A0-A1   * Palautetaan rekisterit
03:00001146 4E75            	   258:     RTS
                            	   259: 
                            	   260: * =================================================================
                            	   261: * TULOSTETTAVA DATA
                            	   262: * =================================================================
                            	   263:             EVEN
                            	   264: 
03:00001148 00000000        	   265: StringPtr:    DS.L  1           * Osoitin tulostettavan merkkijonon nykyiseen merkkiin
                            	   266: 
03:0000114C 00              	   267: HexBuffer:    DS.B  4           
03:0000114D *
                            	   268: 
03:00001150 0000            	   269: CursorX:      DS.W  1           * UUSI: Nykyinen X-koordinaatti (0-799)
03:00001152 0000            	   270: CursorY:      DS.W  1           * UUSI: Nykyinen Y-koordinaatti (0-599)
                            	   271: 
                            	   272: MyMessage:
03:00001154 4D36386B204D7573	   273:     DC.B    "M68k Musashi keskeytystulostus toimii!",10,13,0
03:0000115C 61736869206B6573
03:00001164 6B65797479737475
03:0000116C 6C6F737475732074
03:00001174 6F696D696921
03:0000117A 0A
03:0000117B 0D
03:0000117C 00
                            	   274:     * 10 = Newline (\n), 13 = Carriage Return (\r), 0 = Null-terminaattori
                            	   275: 
                            	   276:             EVEN
                            	   277: 
                            	   278: VGA_Palette_Data:
                            	   279: * --- 16 VGA PERUSVÄRIÄ ---
03:0000117E 00000000        	   280:     DC.L    $00000000    * 0: Musta
03:00001182 000000AA        	   281:     DC.L    $000000AA    * 1: Sininen
03:00001186 0000AA00        	   282:     DC.L    $0000AA00    * 2: Vihreä
03:0000118A 0000AAAA        	   283:     DC.L    $0000AAAA    * 3: Syaani
03:0000118E 00AA0000        	   284:     DC.L    $00AA0000    * 4: Punainen
03:00001192 00AA00AA        	   285:     DC.L    $00AA00AA    * 5: Magenta
03:00001196 00AA5500        	   286:     DC.L    $00AA5500    * 6: Ruskea
03:0000119A 00AAAAAA        	   287:     DC.L    $00AAAAAA    * 7: Vaaleanharmaa
03:0000119E 00555555        	   288:     DC.L    $00555555    * 8: Tummanharmaa
03:000011A2 005555FF        	   289:     DC.L    $005555FF    * 9: Kirkas sininen
03:000011A6 0055FF55        	   290:     DC.L    $0055FF55    * 10: Kirkas vihreä
03:000011AA 0055FFFF        	   291:     DC.L    $0055FFFF    * 11: Kirkas syaani
03:000011AE 00FF5555        	   292:     DC.L    $00FF5555    * 12: Kirkas punainen
03:000011B2 00FF55FF        	   293:     DC.L    $00FF55FF    * 13: Kirkas magenta
03:000011B6 00FFFF55        	   294:     DC.L    $00FFFF55    * 14: Keltainen
03:000011BA 00FFFFFF        	   295:     DC.L    $00FFFFFF    * 15: Valkoinen
                            	   296: 
                            	   297: * --- SATEENKAARI JA VÄRISKAALAT (Värit 16-231) ---
03:000011BE 00000000        	   298:     DC.L    $00000000,$00000040,$00000080,$000000C0,$000000FF,$00004000
03:000011C2 00000040
03:000011C6 00000080
03:000011CA 000000C0
03:000011CE 000000FF
03:000011D2 00004000
03:000011D6 00004040        	   299:     DC.L    $00004040,$00004080,$000040C0,$000040FF,$00008000,$00008040
03:000011DA 00004080
