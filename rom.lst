                            	   535: *
                            	   536: *******************************************************************
                            	   537: *
                            	   538: * *** REM *** IF *** INPUT *** LET (& DEFLT) ***
                            	   539: *
                            	   540: * 'REM' can be followed by anything and is ignored by the
                            	   541: * interpreter.
                            	   542: *
                            	   543: * 'IF' is followed by an expression, as a condition and one or
                            	   544: * more commands (including other 'IF's) separated by colons.
                            	   545: * Note that the word 'THEN' is not used.  The interpreter evaluates
                            	   546: * the expression.  If it is non-zero, execution continues.  If it
                            	   547: * is zero, the commands that follow are ignored and execution
                            	   548: * continues on the next line.
                            	   549: *
                            	   550: * 'INPUT' is like the 'PRINT' command, and is followed by a list
                            	   551: * of items.  If the item is a string in single or double quotes,
                            	   552: * or is an underline (back arrow), it has the same effect as in
                            	   553: * 'PRINT'.  If an item is a variable, this variable name is
                            	   554: * printed out followed by a colon, then the interpreter waits for
                            	   555: * an expression to be typed in.  The variable is then set to the
                            	   556: * value of this expression.  If the variable is preceeded by a
                            	   557: * string (again in single or double quotes), the string will be
                            	   558: * displayed followed by a colon.  The interpreter the waits for an
                            	   559: * expression to be entered and sets the variable equal to the
                            	   560: * expression's value.  If the input expression is invalid, the
                            	   561: * interpreter will print "What?", "How?", or "Sorry" and reprint
                            	   562: * the prompt and redo the input.  The execution will not terminate
                            	   563: * unless you press control-C.  This is handled in 'INPERR'.
                            	   564: *
                            	   565: * 'LET' is followed by a list of items separated by commas.
                            	   566: * Each item consists of a variable, an equals sign, and an
                            	   567: * expression.  The interpreter evaluates the expression and sets
                            	   568: * the variable to that value.  The interpreter will also handle
                            	   569: * 'LET' commands without the word 'LET'.  This is done by 'DEFLT'.
                            	   570: *
01:0000153C 600A            	   571: LREM	BRA	LIF2		skip the rest of the line
                            	   572: 
01:0000153E 610001AA        	   573: LIF	BSR.W	EXPR		evaluate the expression
01:00001542 4A80            	   574: LIF1	TST.L	D0		is it zero?
01:00001544 6600FE3E        	   575: 	BNE	RUNSML		if not, continue
01:00001548 2248            	   576: LIF2	MOVE.L	A0,A1
01:0000154A 7200            	   577: 	CLR.L	D1
01:0000154C 610004FA        	   578: 	BSR.W	FNDSKP		if so, skip the rest of the line
01:00001550 6400FE2A        	   579: 	BCC	RUNTSL		and run the next line
01:00001554 6000FC54        	   580: 	BRA.W	WSTART		if no next line, do a warm start
                            	   581: 
01:00001558 2E781CA8        	   582: INPERR	MOVE.L	STKINP,SP	restore the old stack pointer
01:0000155C 21DF1CA0        	   583: 	MOVE.L	(SP)+,CURRNT	and old 'CURRNT'
01:00001560 588F            	   584: 	ADDQ.L	#4,SP
01:00001562 205F            	   585: 	MOVE.L	(SP)+,A0	and old text pointer
                            	   586: 
01:00001564 2F08            	   587: INPUT	MOVE.L	A0,-(SP)	save in case of error
01:00001566 61000556        	   588: 	BSR.W	QTSTG		is next item a string?
01:0000156A 600A            	   589: 	BRA.S	IP2		nope
01:0000156C 61000266        	   590: 	BSR.W	TSTV		yes, but is it followed by a variable?
01:00001570 654C            	   591: 	BCS	IP4		if not, branch
01:00001572 2440            	   592: 	MOVE.L	D0,A2		put away the variable's address
01:00001574 601A            	   593: 	BRA	IP3		if so, input to variable
01:00001576 2F08            	   594: IP2	MOVE.L	A0,-(SP)	save for 'PRTSTG'
01:00001578 6100025A        	   595: 	BSR.W	TSTV		must be a variable now
01:0000157C 650003B8        	   596: 	BCS.W	QWHAT		"What?" it isn't?
01:00001580 2440            	   597: 	MOVE.L	D0,A2		put away the variable's address
01:00001582 1410            	   598: 	MOVE.B	(A0),D2 	get ready for 'PRTSTG'
01:00001584 4200            	   599: 	CLR.B	D0
01:00001586 1080            	   600: 	MOVE.B	D0,(A0)
01:00001588 225F            	   601: 	MOVE.L	(SP)+,A1
01:0000158A 61000516        	   602: 	BSR.W	PRTSTG		print string as prompt
01:0000158E 1082            	   603: 	MOVE.B	D2,(A0) 	restore text
01:00001590 2F08            	   604: IP3	MOVE.L	A0,-(SP)	save in case of error
01:00001592 2F381CA0        	   605: 	MOVE.L	CURRNT,-(SP)	also save 'CURRNT'
01:00001596 21FCFFFFFFFF1CA0	   606: 	MOVE.L	#-1,CURRNT	flag that we are in INPUT
01:0000159E 21CF1CA8        	   607: 	MOVE.L	SP,STKINP	save the stack pointer too
01:000015A2 2F0A            	   608: 	MOVE.L	A2,-(SP)	save the variable address
01:000015A4 103C003A        	   609: 	MOVE.B	#':',D0         print a colon first
01:000015A8 610003DC        	   610: 	BSR.W	GETLN		then get an input line
01:000015AC 41F81CCC        	   611: 	LEA	BUFFER,A0	point to the buffer
01:000015B0 61000138        	   612: 	BSR.W	EXPR		evaluate the input
01:000015B4 245F            	   613: 	MOVE.L	(SP)+,A2	restore the variable address
01:000015B6 2480            	   614: 	MOVE.L	D0,(A2) 	save value in variable
01:000015B8 21DF1CA0        	   615: 	MOVE.L	(SP)+,CURRNT	restore old 'CURRNT'
01:000015BC 205F            	   616: 	MOVE.L	(SP)+,A0	and the old text pointer
01:000015BE 588F            	   617: IP4	ADDQ.L	#4,SP		clean up the stack
01:000015C0 610005C8        	   618: 	BSR.W	TSTC		is the next thing a comma?
01:000015C4 2C              	   619: 	DC.B	',',IP5-*
01:000015C5 03
01:000015C6 609C            	   620: 	BRA	INPUT		yes, more items
01:000015C8 6000FE6E        	   621: IP5	BRA	FINISH
                            	   622: 
01:000015CC 0C10000D        	   623: DEFLT	CMP.B	#CR,(A0)	empty line is OK
01:000015D0 670C            	   624: 	BEQ	LT1		else it is 'LET'
                            	   625: 
01:000015D2 61000322        	   626: LET	BSR.W	SETVAL		do the assignment
01:000015D6 610005B2        	   627: 	BSR.W	TSTC		check for more 'LET' items
01:000015DA 2C              	   628: 	DC.B	',',LT1-*
01:000015DB 03
01:000015DC 60F4            	   629: 	BRA	LET
01:000015DE 6000FE58        	   630: LT1	BRA	FINISH		until we are finished.
