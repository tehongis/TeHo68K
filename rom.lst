                            	   721: *
                            	   722: *******************************************************************
                            	   723: *
                            	   724: * *** POKE *** & CALL ***
                            	   725: *
                            	   726: * 'POKE expr1,expr2' stores the byte from 'expr2' into the memory
                            	   727: * address specified by 'expr1'.
                            	   728: *
                            	   729: * 'CALL expr' jumps to the machine language subroutine whose
                            	   730: * starting address is specified by 'expr'.  The subroutine can use
                            	   731: * all registers but must leave the stack the way it found it.
                            	   732: * The subroutine returns to the interpreter by executing an RTS.
                            	   733: *
01:000016BE 612A            	   734: POKE	BSR	EXPR		get the memory address
01:000016C0 610004C8        	   735: 	BSR.W	TSTC		it must be followed by a comma
01:000016C4 2C              	   736: 	DC.B	',',PKER-*
01:000016C5 0D
01:000016C6 2F00            	   737: 	MOVE.L	D0,-(SP)	save the address
01:000016C8 6120            	   738: 	BSR	EXPR		get the byte to be POKE'd
01:000016CA 225F            	   739: 	MOVE.L	(SP)+,A1	get the address back
01:000016CC 1280            	   740: 	MOVE.B	D0,(A1) 	store the byte in memory
01:000016CE 6000FD68        	   741: 	BRA	FINISH
01:000016D2 60000262        	   742: PKER	BRA.W	QWHAT		if no comma, say "What?"
                            	   743: 
01:000016D6 6112            	   744: CALL	BSR	EXPR		get the subroutine's address
01:000016D8 4A80            	   745: 	TST.L	D0		make sure we got a valid address
01:000016DA 670002A2        	   746: 	BEQ.W	QHOW		if not, say "How?"
01:000016DE 2F08            	   747: 	MOVE.L	A0,-(SP)	save the text pointer
01:000016E0 2240            	   748: 	MOVE.L	D0,A1
01:000016E2 4E91            	   749: 	JSR	(A1)		jump to the subroutine
01:000016E4 205F            	   750: 	MOVE.L	(SP)+,A0	restore the text pointer
01:000016E6 6000FD50        	   751: 	BRA	FINISH
                            	   752: *
                            	   753: *******************************************************************
                            	   754: *
                            	   755: * *** EXPR ***
                            	   756: *
                            	   757: * 'EXPR' evaluates arithmetical or logical expressions.
                            	   758: * <EXPR>::=<EXPR2>
                            	   759: *	   <EXPR2><rel.op.><EXPR2>
                            	   760: * where <rel.op.> is one of the operators in TAB8 and the result
                            	   761: * of these operations is 1 if true and 0 if false.
                            	   762: * <EXPR2>::=(+ or -)<EXPR3>(+ or -)<EXPR3>(...
                            	   763: * where () are optional and (... are optional repeats.
                            	   764: * <EXPR3>::=<EXPR4>( <* or /><EXPR4> )(...
                            	   765: * <EXPR4>::=<variable>
                            	   766: *	    <function>
                            	   767: *	    (<EXPR>)
                            	   768: * <EXPR> is recursive so that the variable '@' can have an <EXPR>
                            	   769: * as an index, functions can have an <EXPR> as arguments, and
                            	   770: * <EXPR4> can be an <EXPR> in parenthesis.
                            	   771: *
01:000016EA 6152            	   772: EXPR	BSR	EXPR2
01:000016EC 2F00            	   773: 	MOVE.L	D0,-(SP)	save <EXPR2> value
01:000016EE 43F812A9        	   774: 	LEA	TAB8,A1 	look up a relational operator
01:000016F2 45F812EE        	   775: 	LEA	TAB8.1,A2
01:000016F6 6000FC0C        	   776: 	BRA	EXEC		go do it
                            	   777: 
01:000016FA 6132            	   778: XP11	BSR	XP18		is it ">="?
01:000016FC 6D24            	   779: 	BLT	XPRT0		no, return D0=0
01:000016FE 6026            	   780: 	BRA	XPRT1		else return D0=1
                            	   781: 
01:00001700 612C            	   782: XP12	BSR	XP18		is it "<>"?
01:00001702 671E            	   783: 	BEQ	XPRT0		no, return D0=0
01:00001704 6020            	   784: 	BRA	XPRT1		else return D0=1
                            	   785: 
01:00001706 6126            	   786: XP13	BSR	XP18		is it ">"?
01:00001708 6F18            	   787: 	BLE	XPRT0		no, return D0=0
01:0000170A 601A            	   788: 	BRA	XPRT1		else return D0=1
                            	   789: 
01:0000170C 6120            	   790: XP14	BSR	XP18		is it "<="?
01:0000170E 6E12            	   791: 	BGT	XPRT0		no, return D0=0
01:00001710 6014            	   792: 	BRA	XPRT1		else return D0=1
                            	   793: 
01:00001712 611A            	   794: XP15	BSR	XP18		is it "="?
01:00001714 660C            	   795: 	BNE	XPRT0		if not, return D0=0
01:00001716 600E            	   796: 	BRA	XPRT1		else return D0=1
01:00001718 4E75            	   797: XP15RT	RTS
                            	   798: 
01:0000171A 6112            	   799: XP16	BSR	XP18		is it "<"?
01:0000171C 6C04            	   800: 	BGE	XPRT0		if not, return D0=0
01:0000171E 6006            	   801: 	BRA	XPRT1		else return D0=1
