Source: "asm/rom_monitor.asm"
                            	     1: ; =============================================================================
                            	     2: ; M68K ROM Monitori - Sarjaportti-I/O & Sektoripohjainen HDD Ohjain
                            	     3: ; =============================================================================
                            	     4: 
                            	     5:     org     $00000000           ; Absoluuttinen alku muistissa
                            	     6: 
00:00000000 00100000        	     7:     dc.l    $00100000           ; osoite 0: Initial SP (1MB RAM loppu)
00:00000004 00001000        	     8:     dc.l    start               ; osoite 4: Initial PC (Hyppy start-kohtaan)
                            	     9: 
                            	    10: ; =============================================================================
                            	    11: ; Laitteistomääritykset (Memory-Mapped I/O Rekisterit)
                            	    12: ; =============================================================================
                            	    13: IO_STATUS     equ     $00F00000   
                            	    14: IO_DATA       equ     $00F00004   
                            	    15: HDD_COMMAND   equ     $00F00100   
                            	    16: HDD_STATUS    equ     $00F00101   
                            	    17: HDD_SECTOR    equ     $00F00102   
                            	    18: HDD_DMA_ADDR  equ     $00F00108   
                            	    19: 
                            	    20: IO_TIMER      equ     $00F00200   ; 32-bit millisekunnit
                            	    21: 
                            	    22: ; =============================================================================
                            	    23: ; Monitorin käynnistyspiste
                            	    24: ; =============================================================================
                            	    25:     org     $00001000           ; Pakotetaan monitorikoodi osoitteeseen $1000
                            	    26: start:
                            	    27:     ; 1. Avataan virtuaalinen kiintolevy
01:00001000 13FC000100F00100	    28:     move.b  #1,HDD_COMMAND
01:00001008 4A3900F00101    	    29:     tst.b   HDD_STATUS
01:0000100E 6708            	    30:     beq     .hdd_ok
                            	    31:     
01:00001010 41F81132        	    32:     lea     HDD_ERR_MSG,a0
01:00001014 610C            	    33:     bsr     print_string
01:00001016 6006            	    34:     bra     .boot_basic
                            	    35: 
                            	    36: .hdd_ok:
01:00001018 41F810E8        	    37:     lea     WELCOME_MSG,a0
01:0000101C 6104            	    38:     bsr     print_string
                            	    39: 
                            	    40: .boot_basic:
                            	    41:     ; 2. Siirrytään Tiny BASICiin (joka alkaa nyt heti monitorin perään)
01:0000101E 4EF81164        	    42:     jmp     START_BASIC           
                            	    43: 
                            	    44: ; =============================================================================
                            	    45: ; Sisäiset apuohjelmat
                            	    46: ; =============================================================================
                            	    47: print_string:
01:00001022 1018            	    48:     move.b  (a0)+,d0
01:00001024 6704            	    49:     beq     .done
01:00001026 6144            	    50:     bsr     OUTCH
01:00001028 60F8            	    51:     bra     print_string
                            	    52: .done:
01:0000102A 4E75            	    53:     rts
                            	    54: 
                            	    55: ; =============================================================================
                            	    56: ; Kiintolevyn Alirutiinit
                            	    57: ; =============================================================================
                            	    58: HDD_READ_SECTOR:
01:0000102C 23C000F00102    	    59:     move.l  d0,HDD_SECTOR      
01:00001032 23C800F00108    	    60:     move.l  a0,HDD_DMA_ADDR    
01:00001038 13FC000200F00100	    61:     move.b  #2,HDD_COMMAND     
01:00001040 103900F00101    	    62:     move.b  HDD_STATUS,d0      
01:00001046 4E75            	    63:     rts
                            	    64: 
                            	    65: HDD_WRITE_SECTOR:
01:00001048 23C000F00102    	    66:     move.l  d0,HDD_SECTOR      
01:0000104E 23C800F00108    	    67:     move.l  a0,HDD_DMA_ADDR    
01:00001054 13FC000300F00100	    68:     move.b  #3,HDD_COMMAND     
01:0000105C 103900F00101    	    69:     move.b  HDD_STATUS,d0      
01:00001062 4E75            	    70:     rts
                            	    71: 
                            	    72:     xdef    GET_TICKS
                            	    73: GET_TICKS:
01:00001064 203900F00200    	    74:     move.l  IO_TIMER,d0        ; Luetaan 32-bittinen arvo suoraan C-emulaattorilta
01:0000106A 4E75            	    75:     rts
                            	    76: 
                            	    77: ; =============================================================================
                            	    78: ; Päätefunktiot
                            	    79: ; =============================================================================
                            	    80: 
                            	    81: OUTCH:
01:0000106C 1F01            	    82:     move.b  d1,-(sp)
                            	    83: .wait_tx:
01:0000106E 123900F00000    	    84:     move.b  IO_STATUS,d1       
01:00001074 02010002        	    85:     andi.b  #$02,d1            
01:00001078 67F4            	    86:     beq     .wait_tx            
01:0000107A 13C000F00004    	    87:     move.b  d0,IO_DATA         
01:00001080 121F            	    88:     move.b  (sp)+,d1
01:00001082 4E75            	    89:     rts
                            	    90: 
                            	    91: INCH:
01:00001084 103900F00000    	    92:     move.b  IO_STATUS,d0       
01:0000108A 02000001        	    93:     andi.b  #$01,d0            
01:0000108E 67F4            	    94:     beq     INCH                
01:00001090 103900F00004    	    95:     move.b  IO_DATA,d0         
01:00001096 4E75            	    96:     rts
                            	    97: 
                            	    98: TSTAT:
01:00001098 103900F00000    	    99:     move.b  IO_STATUS,d0       
01:0000109E 02000001        	   100:     andi.b  #$01,d0            
01:000010A2 6706            	   101:     beq     .no_char            
01:000010A4 103C00FF        	   102:     move.b  #$FF,d0            
01:000010A8 4E75            	   103:     rts
                            	   104: .no_char:
01:000010AA 103C0000        	   105:     move.b  #$00,d0            
01:000010AE 4E75            	   106:     rts
                            	   107: 
                            	   108: ; =============================================================================
                            	   109: ; TINY BASICIN VAATIMAT APUOHJELMAT (Sillattu C-emulaattorille)
                            	   110: ; =============================================================================
                            	   111:     xdef    AUXOUT
                            	   112: AUXOUT:
01:000010B0 1F01            	   113:     move.b  d1,-(sp)
                            	   114: .wait:
01:000010B2 123900F00000    	   115:     move.b  IO_STATUS,d1       ; Luetaan emulaattorin tilarekisteri
01:000010B8 02010002        	   116:     andi.b  #$02,d1            ; Onko lähetin valmis (Tx)?
01:000010BC 67F4            	   117:     beq     .wait
01:000010BE 13C000F00004    	   118:     move.b  d0,IO_DATA         ; Kirjoitetaan merkki näytölle
01:000010C4 121F            	   119:     move.b  (sp)+,d1
01:000010C6 4E75            	   120:     rts
                            	   121: 
                            	   122:     xdef    AUXIN
                            	   123: AUXIN:
01:000010C8 103900F00000    	   124:     move.b  IO_STATUS,d0       ; Luetaan emulaattorin tilarekisteri
01:000010CE 02000001        	   125:     andi.b  #$01,d0            ; Onko näppäimistöltä merkkiä (Rx)?
01:000010D2 670E            	   126:     beq     .no_char           ; Jos ei, hypätään palauttamaan Zero status
01:000010D4 103900F00004    	   127:     move.b  IO_DATA,d0         ; Luetaan raaka merkki
01:000010DA 0200007F        	   128:     andi.b  #$7F,d0            ; Nollataan ylin bitti (puhtaan ASCII:n varmistus)
01:000010DE 4A00            	   129:     tst.b   d0                 ; Nollataan Zero-lippu, koska merkki löytyi (Z=0)
01:000010E0 4E75            	   130:     rts
                            	   131: .no_char:
01:000010E2 44FC0004        	   132:     move.w  #4,ccr             ; Asetetaan aito CPU Zero status -lippu (Z=1) kokonaisena
01:000010E6 4E75            	   133:     rts
                            	   134: 
