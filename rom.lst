                            	   326: *
                            	   327: *******************************************************************
                            	   328: *
                            	   329: * *** LIST *** PRINT ***
                            	   330: *
                            	   331: * LIST has two forms:
                            	   332: * 'LIST<CR>' lists all saved lines
                            	   333: * 'LIST #<CR>' starts listing at the line #
                            	   334: * Control-S pauses the listing, control-C stops it.
                            	   335: *
                            	   336: * PRINT command is 'PRINT ....:' or 'PRINT ....<CR>'
                            	   337: * where '....' is a list of expressions, formats, back-arrows,
                            	   338: * and strings.	These items a separated by commas.
                            	   339: *
                            	   340: * A format is a pound sign followed by a number.  It controls
                            	   341: * the number of spaces the value of an expression is INCHg to
                            	   342: * be printed in.  It stays effective for the rest of the print
                            	   343: * command unless changed by another format.  If no format is
                            	   344: * specified, 11 positions will be used.
                            	   345: *
                            	   346: * A string is quoted in a pair of single- or double-quotes.
                            	   347: *
                            	   348: * An underline (back-arrow) means generate a <CR> without a <LF>
                            	   349: *
                            	   350: * A <CR LF> is generated after the entire list has been printed
                            	   351: * or if the list is empty.  If the list ends with a semicolon,
                            	   352: * however, no <CR LF> is generated.
                            	   353: *
                            	   354: 
01:000013A8 610007F8        	   355: LLIST	BSR.W	TSTNUM		see if there's a line no.
01:000013AC 6100057C        	   356: 	BSR.W	ENDCHK		if not, we get a zero
01:000013B0 6100066E        	   357: 	BSR.W	FNDLN		find this or next line
01:000013B4 6500FDF4        	   358: LS1	BCS	WSTART		warm start if we passed the end
01:000013B8 610007B6        	   359: 	BSR.W	PRTLN		print the line
01:000013BC 61000870        	   360: 	BSR.W	CHKIO		check for listing halt request
01:000013C0 670C            	   361: 	BEQ	LS3
01:000013C2 B03C0013        	   362: 	CMP.B	#CTRLS,D0	pause the listing?
01:000013C6 6606            	   363: 	BNE	LS3
01:000013C8 61000864        	   364: LS2	BSR.W	CHKIO		if so, wait for another keypress
01:000013CC 67FA            	   365: 	BEQ	LS2
01:000013CE 6100065E        	   366: LS3	BSR.W	FNDLNP		find the next line
01:000013D2 60E0            	   367: 	BRA	LS1
                            	   368: 
01:000013D4 383C000B        	   369: PRINT	MOVE	#11,D4		D4 = number of print spaces
01:000013D8 610007B0        	   370: 	BSR.W	TSTC		if null list and ":"
01:000013DC 3A              	   371: 	DC.B	':',PR2-*
01:000013DD 07
01:000013DE 61000860        	   372: 	BSR.W	CRLF		give CR-LF and continue
01:000013E2 60A0            	   373: 	BRA	RUNSML		execution on the same line
01:000013E4 610007A4        	   374: PR2	BSR.W	TSTC		if null list and <CR>
01:000013E8 0D              	   375: 	DC.B	CR,PR0-*
01:000013E9 09
01:000013EA 61000854        	   376: 	BSR.W	CRLF		also give CR-LF and
01:000013EE 6000FF78        	   377: 	BRA	RUNNXL		execute the next line
01:000013F2 61000796        	   378: PR0	BSR.W	TSTC		else is it a format?
01:000013F6 23              	   379: 	DC.B	'#',PR1-*
01:000013F7 09
01:000013F8 610002F0        	   380: 	BSR.W	EXPR		yes, evaluate expression
01:000013FC 3800            	   381: 	MOVE	D0,D4		and save it as print width
01:000013FE 6016            	   382: 	BRA	PR3		look for more to print
01:00001400 61000788        	   383: PR1	BSR.W	TSTC		is character expression? (MRL)
01:00001404 24              	   384: 	DC.B	'$',PR4-*
01:00001405 0B
01:00001406 610002E2        	   385: 	BSR.W	EXPR		yep. Evaluate expression (MRL)
01:0000140A 6100FC60        	   386: 	BSR	OUTCH		print low byte (MRL)
01:0000140E 6006            	   387: 	BRA	PR3		look for more. (MRL)
01:00001410 610006AC        	   388: PR4	BSR.W	QTSTG		is it a string?
01:00001414 6012            	   389: 	BRA.S	PR8		if not, must be an expression
01:00001416 61000772        	   390: PR3	BSR.W	TSTC		if ",", go find next
01:0000141A 2C              	   391: 	DC.B	',',PR6-*
01:0000141B 07
01:0000141C 610004F2        	   392: 	BSR.W	FIN		in the list.
01:00001420 60D0            	   393: 	BRA	PR0
01:00001422 6100081C        	   394: PR6	BSR.W	CRLF		list ends here
01:00001426 6010            	   395: 	BRA	FINISH
01:00001428 3F04            	   396: PR8	MOVE	D4,-(SP)	save the width value
01:0000142A 610002BE        	   397: 	BSR.W	EXPR		evaluate the expression
01:0000142E 381F            	   398: 	MOVE	(SP)+,D4	restore the width
01:00001430 2200            	   399: 	MOVE.L	D0,D1
01:00001432 610006C8        	   400: 	BSR.W	PRTNUM		print its value
01:00001436 60DE            	   401: 	BRA	PR3		more to print?
                            	   402: 
01:00001438 610004D6        	   403: FINISH	BSR.W	FIN		Check end of command
01:0000143C 600004F8        	   404: 	BRA.W	QWHAT		print "What?" if wrong
                            	   405: 
                            	   406: *
                            	   407: *******************************************************************
                            	   408: *
                            	   409: * *** GOSUB *** & RETURN ***
                            	   410: *
                            	   411: * 'GOSUB expr:' or 'GOSUB expr<CR>' is like the 'GOTO' command,
                            	   412: * except that the current text pointer, stack pointer, etc. are
                            	   413: * saved so that execution can be continued after the subroutine
                            	   414: * 'RETURN's.  In order that 'GOSUB' can be nested (and even
                            	   415: * recursive), the save area must be stacked.  The stack pointer
                            	   416: * is saved in 'STKGOS'.  The old 'STKGOS' is saved on the stack.
                            	   417: * If we are in the main routine, 'STKGOS' is zero (this was done
                            	   418: * in the initialization section of the interpreter), but we still
                            	   419: * save it as a flag for no further 'RETURN's.
                            	   420: *
                            	   421: * 'RETURN<CR>' undoes everything that 'GOSUB' did, and thus
                            	   422: * returns the execution to the command after the most recent
                            	   423: * 'GOSUB'.  If 'STKGOS' is zero, it indicates that we never had
                            	   424: * a 'GOSUB' and is thus an error.
                            	   425: *
01:00001440 6100063A        	   426: GOSUB	BSR.W	PUSHA		save the current 'FOR' parameters
01:00001444 610002A4        	   427: 	BSR.W	EXPR		get line number
01:00001448 2F08            	   428: 	MOVE.L	A0,-(SP)	save text pointer
01:0000144A 2200            	   429: 	MOVE.L	D0,D1
01:0000144C 610005D2        	   430: 	BSR.W	FNDLN		find the target line
01:00001450 6600052E        	   431: 	BNE.W	AHOW		if not there, say "How?"
01:00001454 2F381CA0        	   432: 	MOVE.L	CURRNT,-(SP)	found it, save old 'CURRNT'...
01:00001458 2F381CA4        	   433: 	MOVE.L	STKGOS,-(SP)	and 'STKGOS'
01:0000145C 42B81CAC        	   434: 	CLR.L	LOPVAR		load new values
01:00001460 21CF1CA4        	   435: 	MOVE.L	SP,STKGOS
01:00001464 6000FF16        	   436: 	BRA	RUNTSL
                            	   437: 
01:00001468 610004C0        	   438: RETURN	BSR.W	ENDCHK		there should be just a <CR>
01:0000146C 22381CA4        	   439: 	MOVE.L	STKGOS,D1	get old stack pointer
01:00001470 670004C4        	   440: 	BEQ.W	QWHAT		if zero, it doesn't exist
01:00001474 2E41            	   441: 	MOVE.L	D1,SP		else restore it
01:00001476 21DF1CA4        	   442: 	MOVE.L	(SP)+,STKGOS	and the old 'STKGOS'
01:0000147A 21DF1CA0        	   443: 	MOVE.L	(SP)+,CURRNT	and the old 'CURRNT'
01:0000147E 205F            	   444: 	MOVE.L	(SP)+,A0	and the old text pointer
01:00001480 610005E0        	   445: 	BSR.W	POPA		and the old 'FOR' parameters
01:00001484 60B2            	   446: 	BRA	FINISH		and we are back home
                            	   447: 
                            	   448: *
                            	   449: *******************************************************************
                            	   450: *
                            	   451: * *** FOR *** & NEXT ***
                            	   452: *
                            	   453: * 'FOR' has two forms:
                            	   454: * 'FOR var=exp1 TO exp2 STEP exp1' and 'FOR var=exp1 TO exp2'
                            	   455: * The second form means the same thing as the first form with a
                            	   456: * STEP of positive 1.  The interpreter will find the variable 'var'
                            	   457: * and set its value to the current value of 'exp1'.  It also
                            	   458: * evaluates 'exp2' and 'exp1' and saves all these together with
                            	   459: * the text pointer, etc. in the 'FOR' save area, which consisits of
                            	   460: * 'LOPVAR', 'LOPINC', 'LOPLMT', 'LOPLN', and 'LOPPT'.  If there is
                            	   461: * already something in the save area (indicated by a non-zero
                            	   462: * 'LOPVAR'), then the old save area is saved on the stack before
                            	   463: * the new values are stored.  The interpreter will then dig in the
                            	   464: * stack and find out if this same variable was used in another
                            	   465: * currently active 'FOR' loop.  If that is the case, then the old
                            	   466: * 'FOR' loop is deactivated. (i.e. purged from the stack)
                            	   467: *
                            	   468: * 'NEXT var' serves as the logical (not necessarily physical) end
                            	   469: * of the 'FOR' loop.  The control variable 'var' is checked with
                            	   470: * the 'LOPVAR'.  If they are not the same, the interpreter digs in
                            	   471: * the stack to find the right one and purges all those that didn't
                            	   472: * match.  Either way, it then adds the 'STEP' to that variable and
                            	   473: * checks the result with against the limit value.  If it is within
                            	   474: * the limit, control loops back to the command following the
                            	   475: * 'FOR'.  If it's outside the limit, the save area is purged and
                            	   476: * execution continues.
                            	   477: *
01:00001486 610005F4        	   478: FOR	BSR.W	PUSHA		save the old 'FOR' save area
01:0000148A 6100046A        	   479: 	BSR.W	SETVAL		set the control variable
01:0000148E 21CE1CAC        	   480: 	MOVE.L	A6,LOPVAR	save its address
01:00001492 43F812A1        	   481: 	LEA	TAB5,A1 	use 'EXEC' to test for 'TO'
01:00001496 45F812E6        	   482: 	LEA	TAB5.1,A2
01:0000149A 6000FE68        	   483: 	BRA	EXEC
01:0000149E 6100024A        	   484: FR1	BSR.W	EXPR		evaluate the limit
01:000014A2 21C01CB4        	   485: 	MOVE.L	D0,LOPLMT	save that
01:000014A6 43F812A4        	   486: 	LEA	TAB6,A1 	use 'EXEC' to look for the
01:000014AA 45F812EA        	   487: 	LEA	TAB6.1,A2	word 'STEP'
01:000014AE 6000FE54        	   488: 	BRA	EXEC
01:000014B2 61000236        	   489: FR2	BSR.W	EXPR		found it, get the step value
01:000014B6 6002            	   490: 	BRA	FR4
01:000014B8 7001            	   491: FR3	MOVEQ	#1,D0		not found, step defaults to 1
01:000014BA 21C01CB0        	   492: FR4	MOVE.L	D0,LOPINC	save that too
01:000014BE 21F81CA01CB8    	   493: FR5	MOVE.L	CURRNT,LOPLN	save address of current line number
01:000014C4 21C81CBC        	   494: 	MOVE.L	A0,LOPPT	and text pointer
01:000014C8 2C4F            	   495: 	MOVE.L	SP,A6		dig into the stack to find 'LOPVAR'
01:000014CA 6004            	   496: 	BRA	FR7
01:000014CC 4DEE0014        	   497: FR6	ADD.L	#20,A6		look at next stack frame
01:000014D0 2016            	   498: FR7	MOVE.L	(A6),D0 	is it zero?
01:000014D2 6716            	   499: 	BEQ	FR8		if so, we're done
01:000014D4 B0B81CAC        	   500: 	CMP.L	LOPVAR,D0	same as current LOPVAR?
01:000014D8 66F2            	   501: 	BNE	FR6		nope, look some more
01:000014DA 244F            	   502: 	MOVE.L	SP,A2		Else remove 5 long words from...
01:000014DC 224E            	   503: 	MOVE.L	A6,A1		inside the stack.
01:000014DE 47F80014        	   504: 	LEA	20,A3
01:000014E2 D7C9            	   505: 	ADD.L	A1,A3
01:000014E4 61000574        	   506: 	BSR.W	MVDOWN
01:000014E8 2E4B            	   507: 	MOVE.L	A3,SP		set the SP 5 long words up
01:000014EA 6000FF4C        	   508: FR8	BRA	FINISH		and continue execution
                            	   509: 
01:000014EE 610002E4        	   510: NEXT	BSR.W	TSTV		get address of variable
01:000014F2 65000442        	   511: 	BCS.W	QWHAT		if no variable, say "What?"
01:000014F6 2240            	   512: 	MOVE.L	D0,A1		save variable's address
01:000014F8 20381CAC        	   513: NX0	MOVE.L	LOPVAR,D0	If 'LOPVAR' is zero, we never...
01:000014FC 67000438        	   514: 	BEQ.W	QWHAT		had a FOR loop, so say "What?"
01:00001500 B3C0            	   515: 	CMP.L	D0,A1		else we check them
01:00001502 6706            	   516: 	BEQ	NX3		OK, they agree
01:00001504 6100055C        	   517: 	BSR.W	POPA		nope, let's see the next frame
01:00001508 60EE            	   518: 	BRA	NX0
01:0000150A 2011            	   519: NX3	MOVE.L	(A1),D0 	get control variable's value
01:0000150C D0B81CB0        	   520: 	ADD.L	LOPINC,D0	add in loop increment
01:00001510 6900046C        	   521: 	BVS.W	QHOW		say "How?" for 32-bit overflow
01:00001514 2280            	   522: 	MOVE.L	D0,(A1) 	save control variable's new value
01:00001516 22381CB4        	   523: 	MOVE.L	LOPLMT,D1	get loop's limit value
01:0000151A 4AB81CB0        	   524: 	TST.L	LOPINC
01:0000151E 6A02            	   525: 	BPL	NX1		branch if loop increment is positive
01:00001520 C141            	   526: 	EXG	D0,D1
01:00001522 B280            	   527: NX1	CMP.L	D0,D1		test against limit
01:00001524 6D0E            	   528: 	BLT	NX2		branch if outside limit
01:00001526 21F81CB81CA0    	   529: 	MOVE.L	LOPLN,CURRNT	Within limit, go back to the...
01:0000152C 20781CBC        	   530: 	MOVE.L	LOPPT,A0	saved 'CURRNT' and text pointer.
01:00001530 6000FF06        	   531: 	BRA	FINISH
01:00001534 6100052C        	   532: NX2	BSR.W	POPA		purge this loop
01:00001538 6000FEFE        	   533: 	BRA	FINISH
